---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBox from '../components/CtaBox.astro';
import PlimaTechStack from '../components/PlimaTechStack.astro';
import { getLang, type Lang } from '../i18n';
import fs from 'node:fs';
import path from 'node:path';
const lang = getLang(Astro.currentLocale);
// Screenshot automatisch einbinden, sobald die Datei existiert (public/images/plima-dashboard.png)
// process.cwd() statt import.meta.url: Vite bündelt die Frontmatter beim Build in
// dist/.prerender/chunks/, wodurch ein relativer Pfad zur Quelldatei ins Leere liefe.
const hasPlimaShot = fs.existsSync(path.join(process.cwd(), 'public/images/plima-dashboard.png'));

const copy: Record<Lang, any> = {
  en: {
    title: 'Products – Mirano Solutions',
    desc: 'PLIMA HR software and further SaaS products – designed, built and operated by Mirano Solutions.',
    eyebrow: 'Products',
    h1: 'Software we build and run ourselves',
    lead: 'Our second pillar: own SaaS products. They prove what our teams can do – architecture, quality, ownership – and they keep us honest about what shipping really takes.',
    plima: {
      badge: 'Live · in production',
      name: 'PLIMA',
      kind: 'HR software for small and mid-sized companies',
      text: 'From idea to launch in 3 months: 12 HR modules, one price, data hosted in the EU. PLIMA has been running in production since April 2026, and a second customer has been using it since summer 2026 – built, launched and operated by Mirano.',
      cta: 'Visit plima.cloud →',
      by: 'Developed by Mirano Solutions',
      shots: 'Product screenshots coming soon',
    },
    next: {
      eyebrow: 'In the pipeline',
      items: [
        { name: 'SaaS for freight forwarders', text: 'Digitizes invoices and delivery notes to simplify drivers’ daily work. Aimed at small and mid-sized freight forwarding companies.', tag: 'Autumn 2026' },
        { name: 'Vertical SaaS · Healthcare', text: 'Prototype in place, tailored to the Croatian market.', tag: 'Q1/2027' },
      ],
    },
  },
  de: {
    title: 'Produkte – Mirano Solutions',
    desc: 'PLIMA HR-Software und weitere SaaS-Produkte – konzipiert, gebaut und betrieben von Mirano Solutions.',
    eyebrow: 'Produkte',
    h1: 'Software, die wir selbst bauen und betreiben',
    lead: 'Unsere zweite Säule: eigene SaaS-Produkte. Sie beweisen, was unsere Teams können – Architektur, Qualität, Ownership – und halten uns ehrlich darin, was Liefern wirklich bedeutet.',
    plima: {
      badge: 'Live · produktiv',
      name: 'PLIMA',
      kind: 'HR-Software für kleine und mittlere Unternehmen',
      text: 'Von der Idee zum Launch in 3 Monaten: 12 HR-Module, ein Preis, Daten in der EU gehostet. PLIMA läuft seit April 2026 produktiv, ein zweiter Kunde arbeitet seit Sommer 2026 mit PLIMA – gebaut, gelauncht und betrieben von Mirano.',
      cta: 'plima.cloud besuchen →',
      by: 'Entwickelt von Mirano Solutions',
      shots: 'Produkt-Screenshots folgen in Kürze',
    },
    next: {
      eyebrow: 'In der Pipeline',
      items: [
        { name: 'SaaS für Speditionen', text: 'Digitalisierung von Rechnungen und Lieferscheinen – vereinfacht die tägliche Arbeit der Fahrer. Zielgruppe: kleine und mittelständische Speditionen.', tag: 'Herbst 2026' },
        { name: 'Vertikales SaaS · Medizin', text: 'Prototyp vorhanden, zugeschnitten auf den kroatischen Markt.', tag: 'Q1/2027' },
      ],
    },
  },
  hr: {
    title: 'Proizvodi – Mirano Solutions',
    desc: 'PLIMA HR softver i daljnji SaaS proizvodi – osmišljeni, izgrađeni i održavani od Mirano Solutionsa.',
    eyebrow: 'Proizvodi',
    h1: 'Softver koji sami gradimo i održavamo',
    lead: 'Naš drugi stup: vlastiti SaaS proizvodi. Oni dokazuju što naši timovi mogu – arhitektura, kvaliteta, odgovornost – i drže nas iskrenima o tome što isporuka stvarno znači.',
    plima: {
      badge: 'Live · u produkciji',
      name: 'PLIMA',
      kind: 'HR softver za mala i srednja poduzeća',
      text: 'Od ideje do lansiranja u 3 mjeseca: 12 HR modula, jedna cijena, podaci u EU. PLIMA je u produkciji od travnja 2026., a drugi klijent koristi PLIMA-u od ljeta 2026. – izgrađena, lansirana i održavana od Mirana.',
      cta: 'Posjetite plima.cloud →',
      by: 'Razvio Mirano Solutions',
      shots: 'Snimke zaslona proizvoda uskoro',
    },
    next: {
      eyebrow: 'U pripremi',
      items: [
        { name: 'SaaS za špedicije', text: 'Digitalizacija računa i otpremnica – pojednostavljuje svakodnevni rad vozača. Ciljna skupina: male i srednje špediterske tvrtke.', tag: 'Jesen 2026.' },
        { name: 'Vertikalni SaaS · Medicina', text: 'Prototip postoji, prilagođen hrvatskom tržištu.', tag: 'Q1/2027.' },
      ],
    },
  },
};
const t = copy[lang];
---

<Base title={t.title} description={t.desc}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="container">
      <div class="card plima reveal">
        <div class="plima-accent" aria-hidden="true"></div>
        <div class="plima-copy">
          <span class="plima-badge">{t.plima.badge}</span>
          <h2>{t.plima.name}</h2>
          <p class="plima-kind">{t.plima.kind}</p>
          <p>{t.plima.text}</p>
          <div class="plima-actions">
            <a href="https://plima.cloud" rel="noopener" class="btn-primary">{t.plima.cta}</a>
          </div>
          <p class="plima-by">{t.plima.by}</p>
          <PlimaTechStack lang={lang} />
        </div>
        <div class="plima-visual">
          {
            hasPlimaShot ? (
              <img src="/images/plima-dashboard.png" alt="PLIMA HR dashboard" loading="lazy" class="plima-shot" />
            ) : (
              <div class="shot-placeholder" aria-hidden="true"><span>{t.plima.shots}</span></div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section-limestone">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.next.eyebrow}</span>
        <h2>{t.next.eyebrow}</h2>
      </div>
      <div class="pipeline">
        {
          t.next.items.map((p: any) => (
            <div class="card pipe reveal">
              <span class="pipe-tag">{p.tag}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBox />
</Base>

<style>
  .plima {
    /* PLIMA-Markenfarben – bewusste Ausnahme, nur in dieser Card */
    --plima-primary: #6b3fe4;
    --plima-gradient: linear-gradient(90deg, #9a84f4 0%, #6b3fe4 100%);
    --plima-green: #40af74;
    --plima-green-deep: #1e7a4c;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding: 3rem;
    overflow: hidden;
  }
  .plima-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--plima-gradient);
  }
  .plima-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--plima-green-deep);
    border: 1px solid color-mix(in srgb, var(--plima-green) 45%, transparent);
    background: color-mix(in srgb, var(--plima-green) 8%, transparent);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    margin-bottom: 1.25rem;
  }
  .plima h2 {
    margin-bottom: 0.4rem;
  }
  .plima-kind {
    font-weight: 600;
    color: var(--mirano-ink);
    margin-bottom: 1rem;
  }
  .plima-copy > p {
    color: var(--mirano-slate);
  }
  .plima-actions {
    margin-top: 1.75rem;
  }
  .plima-actions .btn-primary {
    background: var(--plima-primary);
  }
  .plima-actions .btn-primary:hover {
    filter: brightness(1.08);
  }
  .plima-by {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--mirano-muted);
    margin-top: 1rem;
  }
  .plima-copy :global(.plima-tech) {
    margin-top: 1.25rem;
  }
  .plima-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    border: 1px solid var(--mirano-border);
    border-radius: var(--radius-card);
  }
  .shot-placeholder {
    height: 100%;
    min-height: 280px;
    border: 1px dashed var(--mirano-border);
    border-radius: var(--radius-card);
    background: var(--mirano-limestone);
    display: grid;
    place-items: center;
    color: var(--mirano-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .pipeline {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .pipe {
    padding: 1.75rem;
    display: grid;
    gap: 0.6rem;
  }
  .pipe-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--mirano-orange-deep);
  }
  .pipe h3 {
    font-size: 1.0625rem;
  }
  .pipe p {
    font-size: 0.9375rem;
    color: var(--mirano-slate);
  }
  @media (max-width: 900px) {
    .plima {
      grid-template-columns: 1fr;
      padding: 2rem;
    }
    .pipeline {
      grid-template-columns: 1fr;
    }
  }
</style>
