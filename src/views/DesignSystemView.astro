};
const t = copy[lang];

/* Meta-Zeile im Hero: jedes Segment live aus dem Parser. */
const metaLine = [
  'TOKENS.CSS',
  parsed.meta.version?.toUpperCase(),
  parsed.meta.date,
  `${parsed.meta.count} CUSTOM PROPERTIES`,
  t.labels.parsed,
]
  .filter(Boolean)
  .join(' · ');
---

<Base title={t.title} description={t.desc}>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.h1} lead={t.hero.lead} meta={metaLine} />

  <nav class="ds-anchors" aria-label={t.labels.anchors}>
    <div class="container">
      <ul>
        {t.anchors.map(([href, num, label]: [string, string, string]) => (
          <li>
            <a href={href}><span class="idx">{num}</span>{label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- 01 · Farbe -->
  <section id="color" class="section" aria-labelledby="color-h">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.colors.head.eyebrow}</span>
        <h2 id="color-h">{t.colors.head.h2}</h2>
        <p>{t.colors.head.p}</p>
      </div>

      {colorGroups.map((group) => (
        <div class="color-group reveal">
          <h3 class="group-label">{t.colors.groups[group.key]}</h3>
          <div class="tile-grid">
            {group.tokens.map((token) => {
              const meta = t.colors.roles[token.name];
              const c = tileContrast[token.name];
              const gradient = isGradient(token);
              return (
                <div class={`card color-tile${gradient ? ' tile-span' : ''}`}>
                  <div
                    class={`swatch${group.key === 'status' ? ' swatch-sm' : ''}${isLightFill(token) ? ' swatch-line' : ''}`}
                    style={`background: var(${token.name})`}
                    aria-hidden="true"
                  >
                    {c && (
                      <span class="swatch-specimen" style={`color: var(${token.name}); background: var(${c.bgVar})`}>Ag</span>
                    )}
                  </div>
                  <div class="tile-info">
                    <p class="tile-name">{meta?.name ?? token.name}</p>
                    <p class="mono-meta tile-code">{token.name} · {gradient ? gradientNote(token) : token.value}</p>
                    {meta?.role && <p class="tile-role">{meta.role}</p>}
                    {c && (
                      <p class="mono-meta tile-contrast">{c.note} · {c.onDark ? t.labels.onGraphite : t.labels.worstCase}</p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}

      {plima.length > 0 && (
        <div class="plima-quarantine reveal">
          <p class="quarantine-label">{t.colors.plima.label} — /PRODUCTS</p>
          <h3>{t.colors.plima.h3}</h3>
          <p class="tile-role">{t.colors.plima.p}</p>
          <ul class="plima-dots" role="list">
            {plima.map((p) => (
              <li>
                <span class="plima-dot" style={`background: ${p.value}`} aria-hidden="true"></span>
                <span class="mono-meta tile-code">{p.name} · {p.value}</span>
              </li>
            ))}
          </ul>
          <p class="mono-meta quarantine-src">{t.labels.source}: SRC/VIEWS/PRODUCTSVIEW.ASTRO</p>
        </div>
      )}
    </div>
  </section>

  <!-- 02 · Typografie -->
  <section id="type" class="section section-limestone" aria-labelledby="type-h">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.type.head.eyebrow}</span>
        <h2 id="type-h">{t.type.head.h2}</h2>
        <p>{t.type.head.p}</p>
      </div>

      <div class="type-families reveal">
        {families.map((f) => (
          <div class="card info-card type-card">
            <p class={`type-aa ${f.cls}`} aria-hidden="true">Aa</p>
            <h3>{t.type.families[f.key].h3}</h3>
            <p class="mono-meta tile-code">{f.token!.name} · {f.token!.value}</p>
            <p class="mono-meta type-weights">{t.type.weightsLabel} · {f.weights}</p>
            <p class="tile-role">{t.type.families[f.key].usage}</p>
            {f.key === 'mono' && (
              <>
                <span class="stat-number type-stat" aria-hidden="true">0123456789</span>
                <p class="tile-role">{t.type.dataFace}</p>
              </>
            )}
          </div>
        ))}
      </div>

      <div class="type-ladder reveal">
        {ladder.map((row) => (
          <div class="ladder-row">
            <span class={`spec ${row.cls}`}>{t.type.ladder[row.name]}</span>
            <p class="mono-meta ladder-note">
              {row.name} · {row.value}{row.px ? ` · ${row.px}` : ''}<span class="live-size" data-suffix={t.labels.live}></span>
            </p>
          </div>
        ))}
      </div>

      <div class="type-marginalia reveal">
        {marginalia.map((token) => (
          <span class="mono-meta">{token.name} · {token.value}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · Logo -->
  <section id="logo" class="section" aria-labelledby="logo-h">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.logo.head.eyebrow}</span>
        <h2 id="logo-h">{t.logo.head.h2}</h2>
        <p>{t.logo.head.p}</p>
      </div>

      <div class="logo-grid reveal">
        <div class="card logo-tile">
          <div class="logo-stage">
            <img src="/logo/mirano.svg" alt="" width="356" height="167" loading="lazy" />
          </div>
          <div class="tile-info">
            <p class="tile-name">{t.logo.variants.full}</p>
            <p class="mono-meta tile-code">/logo/mirano.svg</p>
          </div>
        </div>
        <div class="card logo-tile">
          <div class="logo-stage logo-stage-dark">
            <img src="/logo/mirano-white.svg" alt="" width="356" height="167" loading="lazy" />
          </div>
          <div class="tile-info">
            <p class="tile-name">{t.logo.variants.white}</p>
            <p class="mono-meta tile-code">/logo/mirano-white.svg</p>
          </div>
        </div>
        <div class="card logo-tile">
          <div class="logo-stage">
            <img class="logo-icon" src="/favicon.svg" alt="" width="64" height="64" loading="lazy" />
          </div>
          <div class="tile-info">
            <p class="tile-name">{t.logo.variants.icon}</p>
            <p class="mono-meta tile-code">/favicon.svg</p>
          </div>
        </div>
      </div>

      <div class="card clearspace reveal">
        <div class="clearspace-stage">
          <div class="cs-frame" aria-hidden="true">
