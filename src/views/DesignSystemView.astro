<script>
  // Replay der Motion-Demo: Klassen-Reset + erzwungener Reflow, dann erneut animieren.
  // Der globale Reveal-Observer (Base.astro) unobserved nach dem ersten Treffer –
  // danach gehört die Klasse diesem Script, kein Konflikt.
  const demo = document.getElementById('motion-demo');
  const replayBtn = document.querySelector('.replay');
  if (demo && replayBtn) {
    replayBtn.addEventListener('click', () => {
      demo.style.removeProperty('transition-delay');
      demo.classList.remove('is-visible');
      void demo.offsetWidth;
      demo.classList.add('is-visible');
    });
  }

  // Typo-Treppe: aktuell berechnete px-Größe je Stufe (clamp() lebt) – aktualisiert bei Resize.
  const rows = document.querySelectorAll('.ladder-row');
  const updateSizes = () => {
    rows.forEach((row) => {
      const spec = row.querySelector('.spec');
      const out = row.querySelector('.live-size') as HTMLElement | null;
      if (spec && out) {
        const px = Math.round(parseFloat(getComputedStyle(spec).fontSize) * 10) / 10;
        out.textContent = ` · ${px}px ${out.dataset.suffix ?? 'live'}`;
      }
    });
  };
  updateSizes();
  let raf = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(updateSizes);
  });
</script>

