---
/*
 * /design-system – das System, dokumentiert durch sich selbst.
 *
 * Jeder gezeigte WERT (Hex, px, ms, Bezier, clamp) wird zur Build-Zeit aus
 * src/styles/tokens.css geparst (src/utils/design-tokens.ts) – nie von Hand
 * eingetragen. Visuals nutzen var(--token): Text und Darstellung hängen damit
 * beide an derselben Quelldatei und können nicht driften.
 *
 * Rollen-/Regel-PROSA ist dreisprachige Copy (wie überall im Projekt), gekeyt
 * am Token-Namen: verschwindet ein Token aus tokens.css, verschwindet seine
 * Kachel (Build-Warnung), nichts bricht.
 *
 * Annotations-Ebene (gestrichelte 1px-Linien + Mono-Labels für Vermessung:
 * Schutzzone, Container-Klammern, PLIMA-Quarantäne): Meta-Sprache ÜBER das
 * System, bewusst nicht Teil des Systems selbst – keine neue Designregel.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBox from '../components/CtaBox.astro';
import { getLang, type Lang } from '../i18n';
import {
  parseTokensCss,
  parsePlimaProps,
  pick,
  parseClamp,
  parseBezier,
  parseMs,
  parseGradient,
  remToPx,
  type Token,
} from '../utils/design-tokens';
import { contrastRatio, formatRatio, wcagLevel, relativeLuminance } from '../utils/contrast';
// Nur bereits verifizierte Marken-Icons (Standing-Rule: kein Eintrag ohne geprüftes Icon).
import { siAstro, siTypescript, siPostgresql } from 'simple-icons';

const lang = getLang(Astro.currentLocale);

const parsed = parseTokensCss();
const { byName } = parsed;
const plima = parsePlimaProps();
const val = (name: string): string => byName[name]?.value ?? '';

/* ----- Kontrast-Badges: Text-Tokens gegen ihre realen Nutzungs-Hintergründe ----- */
const LIGHT_BGS = ['--mirano-porcelain', '--mirano-limestone', '--mirano-white'];
const TEXT_ON_LIGHT = ['--mirano-ink', '--mirano-slate', '--mirano-muted', '--mirano-orange-deep'];
const TEXT_ON_DARK = ['--mirano-text-on-dark', '--mirano-text-on-dark-body', '--mirano-orange-light'];

interface TileContrast {
  note: string;
  bgVar: string;
  onDark: boolean;
}
const tileContrast: Record<string, TileContrast> = {};
for (const name of TEXT_ON_LIGHT) {
  const fg = val(name);
  if (!fg) continue;
  let worst: { ratio: number; bg: string } | null = null;
  for (const bg of LIGHT_BGS) {
    const r = contrastRatio(fg, val(bg));
    if (r !== null && (!worst || r < worst.ratio)) worst = { ratio: r, bg };
  }
  if (worst) {
    const level = wcagLevel(worst.ratio);
    tileContrast[name] = {
      note: `${formatRatio(worst.ratio)}${level ? ` · ${level}` : ''}`,
      bgVar: worst.bg,
      onDark: false,
    };
  }
}
for (const name of TEXT_ON_DARK) {
  const r = contrastRatio(val(name), val('--mirano-graphite'));
  if (r !== null) {
    const level = wcagLevel(r);
    tileContrast[name] = {
      note: `${formatRatio(r)}${level ? ` · ${level}` : ''}`,
      bgVar: '--mirano-graphite',
      onDark: true,
    };
  }
}

/* Helle Füllungen bekommen eine Trennlinie unterm Swatch – berechnet, nicht getaggt. */
const isLightFill = (token: Token): boolean => {
  const l = relativeLuminance(token.value);
  return l !== null && l > 0.55;
};
const isGradient = (token: Token): boolean => token.value.startsWith('linear-gradient');
const gradientNote = (token: Token): string => {
  const g = parseGradient(token.value);
  return g ? `${g.angle} · ${g.stops.join(' → ')}` : token.value;
};

/* ----- Farb-Gruppen (Reihenfolge = tokens.css-Gliederung) ----- */
const COLOR_GROUPS = [
  { key: 'accent', names: ['--mirano-orange', '--mirano-orange-deep', '--mirano-orange-light', '--mirano-gradient', '--mirano-gradient-logo'] },
  { key: 'dark', names: ['--mirano-graphite', '--mirano-graphite-soft', '--mirano-border-on-dark'] },
  { key: 'text', names: ['--mirano-ink', '--mirano-slate', '--mirano-muted', '--mirano-text-on-dark', '--mirano-text-on-dark-body'] },
  { key: 'surface', names: ['--mirano-porcelain', '--mirano-limestone', '--mirano-white', '--mirano-border'] },
  { key: 'status', names: ['--mirano-success', '--mirano-warning', '--mirano-error'] },
] as const;
const colorGroups = COLOR_GROUPS.map((g) => ({ key: g.key, tokens: pick(parsed, [...g.names]) }));

/* ----- Typo: Familien & Hierarchie-Treppe ----- */
// Gewichte = die tatsächlich geladenen Fontsource-Imports aus Base.astro (Load-Config, kein Token).
const families = [
  { key: 'display', token: byName['--font-display'], weights: '600 · 700', cls: 'ff-display' },
  { key: 'body', token: byName['--font-body'], weights: '400 · 500 · 600', cls: 'ff-body' },
  { key: 'mono', token: byName['--font-mono'], weights: '400 · 500', cls: 'ff-mono' },
].filter((f) => f.token);

const LADDER = [
  { name: '--text-h1', cls: 'spec-h1' },
  { name: '--text-h2', cls: 'spec-h2' },
  { name: '--text-h3', cls: 'spec-h3' },
  { name: '--text-h4', cls: 'spec-h4' },
  { name: '--text-body', cls: 'spec-body' },
  { name: '--text-small', cls: 'spec-small' },
  { name: '--text-eyebrow', cls: 'spec-eyebrow' },
];
const ladder = LADDER.flatMap((def) => {
  const token = byName[def.name];
  if (!token) {
    console.warn(`[design-tokens] Token fehlt in tokens.css und wird übersprungen: ${def.name}`);
    return [];
  }
  const clamp = parseClamp(token.value);
  let px = '';
  if (clamp) {
    const min = remToPx(clamp.min);
    const max = remToPx(clamp.max);
    if (min !== null && max !== null) px = `min ${min}px · max ${max}px`;
  } else {
    const p = remToPx(token.value);
    if (p !== null) px = `${p}px`;
  }
  return [{ ...def, value: token.value, px }];
});
const marginalia = pick(parsed, ['--leading-tight', '--leading-body', '--tracking-display', '--tracking-eyebrow', '--tracking-meta']);

/* ----- Spacing & Radius ----- */
const radii = pick(parsed, ['--radius-control', '--radius-card', '--radius-feature']);
const rhythm = pick(parsed, ['--section-y-desktop', '--section-y-mobile']).map((t) => ({
  ...t,
  px: remToPx(t.value),
}));
const containerToken = byName['--container-max'];

/* ----- Motion ----- */
const durTokens = pick(parsed, ['--dur-fast', '--dur-base', '--dur-entrance']).map((t) => ({
  ...t,
  ms: parseMs(t.value) ?? 0,
}));
const maxMs = Math.max(...durTokens.map((d) => d.ms), 1);
const durations = durTokens.map((d) => ({ ...d, pct: Math.round((d.ms / maxMs) * 100) }));
const durSummary = durTokens.map((d) => d.ms).join(' / ');
const easeToken = byName['--ease-out'];
const bez = easeToken ? parseBezier(easeToken.value) : null;
const easePath = bez
  ? `M 0 100 C ${bez[0] * 100} ${100 - bez[1] * 100}, ${bez[2] * 100} ${100 - bez[3] * 100}, 100 0`
  : null;

/* ----- Komponenten: Chips (Rezept aus TechBand.astro, Icons verifiziert) ----- */
const chips = [siAstro, siTypescript, siPostgresql].map((i) => ({ title: i.title, hex: i.hex, svg: i.svg }));

