---
// Kontakt: bewusst kein Selbstbedienungs-Kalender zur eigenständigen
// Slot-Auswahl, auch nicht als Ankündigung dafür – stattdessen ein klarer
// Mailto-CTA plus dieselbe Adresse zusätzlich als sichtbarer, kopierbarer
// Klartext (Fallback, falls der mailto-Klick beim Besucher aus irgendeinem
// Grund nichts öffnet).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getLang, type Lang } from '../i18n';
const lang = getLang(Astro.currentLocale);

const copy: Record<Lang, any> = {
  en: {
    title: 'Contact – Mirano Solutions',
    desc: 'Talk directly to the founder: requirements, matching profiles, realistic timeline. Reply within 24h.',
    eyebrow: 'Contact',
    h1: 'Talk to the founder',
    lead: 'No form marathon, no account manager. Write an email – you get a reply within 24 hours.',
    emailLabel: 'Email',
    phoneLabel: 'Phone',
    phoneHours: 'Mon–Fri, 10:00–18:00 CET',
    addressLabel: 'Address',
    linkedinLabel: 'LinkedIn',
    ctaTitle: 'Email us directly',
    ctaText: 'The fastest way to reach us – you get a reply within 24 hours.',
    emailFallbackIntro: 'Button not opening your email app? Copy the address directly:',
    trust: 'EU CONTRACTS · GDPR-NATIVE · REPLY WITHIN 24H',
  },
  de: {
    title: 'Kontakt – Mirano Solutions',
    desc: 'Direkt mit dem Gründer sprechen: Anforderungen, passende Profile, realistischer Zeitplan. Antwort innerhalb von 24h.',
    eyebrow: 'Kontakt',
    h1: 'Mit dem Gründer sprechen',
    lead: 'Kein Formular-Marathon, kein Account Manager. Schreiben Sie eine E-Mail – Antwort innerhalb von 24 Stunden.',
    emailLabel: 'E-Mail',
    phoneLabel: 'Telefon',
    phoneHours: 'Mo–Fr, 10:00–18:00 Uhr',
    addressLabel: 'Adresse',
    linkedinLabel: 'LinkedIn',
    ctaTitle: 'Schreiben Sie uns direkt',
    ctaText: 'Der schnellste Weg zu uns – Antwort innerhalb von 24 Stunden.',
    emailFallbackIntro: 'Button öffnet Ihr E-Mail-Programm nicht? Adresse direkt kopieren:',
    trust: 'EU-VERTRÄGE · DSGVO-NATIV · ANTWORT INNERHALB VON 24H',
  },
  hr: {
    title: 'Kontakt – Mirano Solutions',
    desc: 'Razgovarajte izravno s osnivačem: zahtjevi, odgovarajući profili, realan vremenski plan. Odgovor unutar 24h.',
    eyebrow: 'Kontakt',
    h1: 'Razgovarajte s osnivačem',
    lead: 'Bez maratona obrazaca, bez account managera. Pošaljite e-mail – odgovor unutar 24 sata.',
    emailLabel: 'E-mail',
    phoneLabel: 'Telefon',
    phoneHours: 'Pon–pet, 10:00–18:00',
    addressLabel: 'Adresa',
    linkedinLabel: 'LinkedIn',
    ctaTitle: 'Pišite nam izravno',
    ctaText: 'Najbrži način da nas dosegnete – odgovor unutar 24 sata.',
    emailFallbackIntro: 'Gumb ne otvara vaš e-mail program? Kopirajte adresu izravno:',
    trust: 'EU UGOVORI · GDPR-USKLAĐENO · ODGOVOR UNUTAR 24H',
  },
};
const t = copy[lang];
---

<Base title={t.title} description={t.desc}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info reveal">
        <div class="ci-block">
          <span class="ci-label">{t.emailLabel}</span>
          <a href="mailto:info@mirano-solutions.com" class="ci-value">info@mirano-solutions.com</a>
        </div>
        <div class="ci-block">
          <span class="ci-label">{t.phoneLabel}</span>
          <a href="tel:+385976795944" class="ci-value">(+385) 9 767 959 44</a>
          <span class="ci-meta">{t.phoneHours}</span>
        </div>
        <div class="ci-block">
          <span class="ci-label">{t.addressLabel}</span>
          <span class="ci-value" style="font-size:1.0625rem">Mirano Solutions d.o.o.<br />Ograjska ulica 1C<br />10000 Zagreb</span>
        </div>
        <div class="ci-block">
          <span class="ci-label">{t.linkedinLabel}</span>
          <a href="https://de.linkedin.com/in/armin-zalihic-53a727201" target="_blank" rel="noopener" class="ci-value">Armin Zalihić →</a>
        </div>
        <p class="ci-trust">{t.trust}</p>
      </div>

      <div class="contact-cta card reveal">
        <div class="contact-cta-accent" aria-hidden="true"></div>
        <h2>{t.ctaTitle}</h2>
        <p>{t.ctaText}</p>
        <a href="mailto:info@mirano-solutions.com" class="btn-primary email-cta">info@mirano-solutions.com</a>
        <p class="email-fallback">
          {t.emailFallbackIntro} <span class="email-fallback-address">info@mirano-solutions.com</span>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
    align-items: start;
  }
  .contact-info {
    display: grid;
    gap: 2rem;
  }
  .ci-block {
    display: grid;
    gap: 0.35rem;
  }
  .ci-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-orange-deep);
  }
  .ci-value {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--mirano-ink);
    text-decoration: none;
  }
  a.ci-value:hover {
    color: var(--mirano-orange-deep);
  }
  .ci-meta {
    font-size: var(--text-small);
    color: var(--mirano-muted);
  }
  .ci-trust {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    color: var(--mirano-muted);
  }
  .contact-cta {
    position: relative;
    padding: 2.5rem;
    overflow: hidden;
  }
  .contact-cta-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--mirano-gradient);
    /* Signature-Linie zeichnet sich beim Reveal */
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out) 150ms;
  }
  .contact-cta.is-visible .contact-cta-accent {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-cta-accent {
      transform: none;
    }
  }
  .contact-cta h2 {
    margin-bottom: 0.75rem;
  }
  .contact-cta > p {
    color: var(--mirano-slate);
    margin-bottom: 1.5rem;
  }
  .email-cta {
    margin-bottom: 1.25rem;
  }
  .email-fallback {
    font-size: var(--text-small);
    color: var(--mirano-muted);
  }
  .email-fallback-address {
    font-family: var(--font-mono);
    color: var(--mirano-ink);
    /* Ein Klick markiert die ganze Adresse – erleichtert das Kopieren als Klartext-Fallback */
    user-select: all;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
