    ],
    milestonesLabel: 'The path',
    milestones: [
      ['2008', 'Start in IT at Mawoh GmbH: systems integration & network security'],
      ['2018', 'SAP test management via PROCON IT at a premium automotive manufacturer in Munich'],
      ['2020', 'CPUX-F certification · drove a UX innovation project, grew it with team & client work, later project lead'],
      ['2021', 'First assignment in Zagreb: nearshore through PROCON IT'],
      ['2022–2025', 'Directly employed by CONET: IT infrastructure, recruiting & strategy – team built up to 100+ employees'],
      ['2025', 'Founded Mirano Solutions d.o.o. in Zagreb'],
      ['2026', 'PLIMA live · engagement at a Munich insurance group · team growing'],
    ],
    certsLabel: 'Certifications (selected)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn profile →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Principles',
    principlesTitle: 'What we hold ourselves to',
    principles: [
      ['Max. 40 experts', 'We cap the pool on purpose. Every profile is known to us personally – no CV databases.'],
      ['Quality over growth', 'We would rather decline a project than staff it below our standard.'],
      ['Direct communication', 'You talk to the founder and to the engineers doing the work. No account layer.'],
      ['Own products keep us honest', 'We ship and operate our own SaaS – so we know what delivery really costs.'],
    ],
  },
  de: {
    title: 'Über Mirano – Mirano Solutions',
    desc: 'Founder-led Engineering-Partner aus Zagreb: 15+ Jahre IT, Aufbau einer 100-Personen-Organisation, gegründet 2025. Max. 40 Experten, Qualität vor Wachstum.',
    eyebrow: 'Über Mirano',
    h1: 'Founder-led, aus Überzeugung',
    lead: 'Mirano Solutions wurde 2025 in Zagreb gegründet – auf Basis von über 15 Jahren IT-Erfahrung und einer Überzeugung: Senior-Qualität und direkte Wege schlagen Größe.',
    storyEyebrow: 'Die Founder-Story',
    storyTitle: 'Warum es Mirano gibt',
    founderAlt: 'Armin Zalihić, Gründer von Mirano Solutions',
    founderCaption: 'Armin Zalihić · Gründer',
    zagrebAlt: 'Zagreb, Kroatien',
    story: [
      'Viele Unternehmen kennen das Muster aus früheren Nearshoring-Versuchen: Am Anfang überzeugend, am Ende ein austauschbares Team ohne echten Ansprechpartner. Mirano ist die bewusste Antwort darauf.',
      'Armin Zalihić ist seit 2008 in der IT: Systemintegration und Netzwerk-Security, später SAP-Testmanagement für einen Premium-Automobilkonzern, dann UX-zertifizierte Projektleitung. Vier Jahre, 2021 bis 2025, gestaltet er maßgeblich mit – strategische Steuerung inklusive, in enger Abstimmung mit der Geschäftsführung – wie eine deutsche IT-Gruppe mit über 1.900 Mitarbeitenden ihre Zagreb-Niederlassung auf über 100 Mitarbeitende vor Ort aufbaut. Genau dort zeigt sich die Erkenntnis, auf der Mirano beruht: Je größer ein Team wird, desto schwerer wird es, jedes Profil persönlich zu kennen und für jede Besetzung selbst einzustehen.',
      '2025 gründet er deshalb Mirano – bewusst klein: maximal 40 Experten, jedes Profil persönlich bekannt, kein Account-Management zwischen Kunde und Gründer. Eigene Produkte wie PLIMA sorgen dafür, dass Mirano weiß, was Lieferung wirklich kostet – nicht nur behauptet. Ob Versicherungskonzern in München oder Mittelständler in Kroatien: Am Ende zählt dieselbe Frage wie 2008 – läuft es?',
      'Ebenso Teil davon: Mirano begleitet auch kleinere kroatische Unternehmen bei Digitalisierung und Website-Relaunches.',
    ],
    milestonesLabel: 'Der Weg',
    milestones: [
      ['2008', 'Start in der IT bei Mawoh GmbH: Systemintegration & Netzwerk-Security'],
      ['2018', 'SAP-Testmanagement via PROCON IT bei einem Premium-Automobilhersteller in München'],
      ['2020', 'CPUX-F-Zertifizierung · UX-Innovation vorangetrieben, mit Team & Aufträgen ausgebaut, später Projektleitung'],
      ['2021', 'Erster Einsatz in Zagreb: Nearshore über PROCON IT'],
      ['2022–2025', 'Direkt bei CONET angestellt: IT-Infrastruktur, Recruiting & Strategie – Team auf 100+ Mitarbeitende'],
