---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBox from '../components/CtaBox.astro';
import { getLang, type Lang } from '../i18n';
const lang = getLang(Astro.currentLocale);

const copy: Record<Lang, any> = {
  en: {
    title: 'About us – Mirano Solutions',
    desc: 'Founder-led engineering partner from Zagreb: 15+ years in IT, buildup of a 100-person organization, founded 2025. Max. 40 experts, quality over growth.',
    eyebrow: 'About us',
    h1: 'Founder-led, by design',
    lead: 'Mirano Solutions was founded in 2025 in Zagreb – built on 15+ years of IT experience and one conviction: senior quality and direct communication beat scale.',
    storyEyebrow: 'The founder story',
    storyTitle: 'Why Mirano exists',
    founderAlt: 'Armin Zalihic, founder of Mirano Solutions',
    founderCaption: 'Armin Zalihic · Founder',
    zagrebAlt: 'Zagreb, Croatia',
    story: [
      'Mirano grew out of an observation that kept proving itself over fifteen years. It begins in 2008 in Munich, where Armin Zalihic – raised there – spent his first years in IT on systems integration and network security: firewalls, networks, systems that simply have to run. Start out that way and you learn early that in the end, what counts is not what was promised – it’s what runs.',
      'In 2018 the path led to a premium automotive brand in Munich, into SAP test management. There it isn’t enough for something to work – you have to be able to show that it holds up under load and in concert with everything around it. Quality goes from an ambition to a method.',
      'And in 2020, with certification as a UX project lead (CPUX-F), a third perspective was added: most projects don’t fail on technology, but at the point where people meet it. The UX work at the brand began as an in-house innovation project, which he joined through PROCON IT – first as a team member. He helped build it out and later took over the project lead, responsible for the outcome and the people at once for the first time.',
      'The most formative chapter began in early 2021 in Zagreb, where a German IT group was building its Croatian branch. For about a year he was there on a nearshore assignment through PROCON IT, a CONET company; in April 2022 the holding hired him directly – three more years, until spring 2025. Four years in total, in which he helped build the company from the ground up: the on-site IT infrastructure, recruiting, developing people, budgets and partnerships in coordination with executive management. Internal projects also served to give younger developers and analysts real responsibility. Over that time, the team grew to more than 100 employees.',
      'The insight Mirano is built on comes from those years – not a criticism of large organizations, but a mechanism you can observe up close: the bigger a team gets, the harder it becomes to know every profile personally and to stand behind every staffing decision yourself. Yet that is exactly where delivery is decided.',
      'In 2025, this became Mirano Solutions in Zagreb – deliberately kept small: a pool of at most 40 experts, every profile personally known, senior-led teams from the EU for the DACH market, a short line to the founder. Plus products of our own – not as a showcase, but because you calculate more honestly when you operate what you build.',
      'Since 2026, PLIMA, our own SaaS platform, has been live, and in Munich Mirano supports an insurance group. Just as much a part of the company: supporting smaller Croatian businesses with digitization and website relaunches. Projects large and small are measured against the same question as in 2008 – in the end, what counts is what runs.',
    ],
    milestonesLabel: 'The path',
    milestones: [
      ['2008', 'Start in IT: systems integration & network security'],
      ['2018', 'SAP test management at a premium automotive brand in Munich'],
      ['2020', 'CPUX-F certification · UX innovation project at the automotive brand, later project lead'],
      ['2021', 'First assignment in Zagreb: nearshore through PROCON IT'],
      ['2022–2025', 'Directly employed by the holding: IT infrastructure, recruiting & strategy – team built up to 100+ employees'],
      ['2025', 'Founded Mirano Solutions d.o.o. in Zagreb'],
      ['2026', 'PLIMA live · engagement at a Munich insurance group · team growing'],
    ],
    certsLabel: 'Certifications (selected)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn profile →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Principles',
    principlesTitle: 'What we hold ourselves to',
    principles: [
      ['Max. 40 experts', 'We cap the pool on purpose. Every profile is known to us personally – no CV databases.'],
      ['Quality over growth', 'We would rather decline a project than staff it below our standard.'],
      ['Direct communication', 'You talk to the founder and to the engineers doing the work. No account layer.'],
      ['Own products keep us honest', 'We ship and operate our own SaaS – so we know what delivery really costs.'],
    ],
  },
  de: {
    title: 'Über Mirano – Mirano Solutions',
    desc: 'Founder-led Engineering-Partner aus Zagreb: 15+ Jahre IT, Aufbau einer 100-Personen-Organisation, gegründet 2025. Max. 40 Experten, Qualität vor Wachstum.',
    eyebrow: 'Über Mirano',
    h1: 'Founder-led, aus Überzeugung',
    lead: 'Mirano Solutions wurde 2025 in Zagreb gegründet – auf Basis von über 15 Jahren IT-Erfahrung und einer Überzeugung: Senior-Qualität und direkte Wege schlagen Größe.',
    storyEyebrow: 'Die Founder-Story',
    storyTitle: 'Warum es Mirano gibt',
    founderAlt: 'Armin Zalihic, Gründer von Mirano Solutions',
    founderCaption: 'Armin Zalihic · Gründer',
    zagrebAlt: 'Zagreb, Kroatien',
    story: [
      'Mirano ist aus einer Beobachtung entstanden, die sich über fünfzehn Jahre immer wieder bestätigt hat. Sie beginnt 2008 in München, wo Armin Zalihic – dort aufgewachsen – seine ersten Jahre in der IT verbringt: Systemintegration und Netzwerk-Security, Firewalls und Netze, die einfach laufen müssen. Wer so anfängt, lernt früh: Am Ende zählt nicht, was versprochen wurde, sondern was läuft.',
      '2018 führt der Weg zu einer Premium-Automobilmarke nach München, ins SAP-Testmanagement. Dort reicht es nicht, dass etwas funktioniert – man muss belegen können, dass es auch unter Last und im Zusammenspiel hält. Qualität wird vom Anspruch zur Methode.',
      'Und 2020 kommt mit der Zertifizierung zum UX-Projektleiter (CPUX-F) eine dritte Perspektive dazu: Die meisten Projekte scheitern nicht an der Technik, sondern dort, wo Menschen auf sie treffen. Die UX-Arbeit bei der Marke beginnt als hausinternes Innovationsprojekt, in dem er über PROCON IT zunächst als Teammitglied mitarbeitet. Er baut es mit aus und übernimmt später die Projektleitung – zum ersten Mal verantwortlich für Ergebnis und Team zugleich.',
      'Das prägendste Kapitel beginnt Anfang 2021 in Zagreb, wo eine deutsche IT-Gruppe ihre kroatische Niederlassung aufbaut. Rund ein Jahr ist er dort im Nearshore-Einsatz über PROCON IT, ein CONET-Unternehmen; im April 2022 stellt ihn die Holding direkt an – drei weitere Jahre, bis Frühjahr 2025. Vier Jahre insgesamt, in denen er das Unternehmen von Grund auf mitbaut: IT-Infrastruktur vor Ort, Recruiting, Entwicklung von Mitarbeitenden, Budgets und Partnerschaften in Abstimmung mit der Geschäftsführung. Interne Projekte dienen dabei auch dazu, jüngeren Entwicklern und Analysten echte Verantwortung zu geben. In dieser Zeit wächst das Team auf über 100 Mitarbeitende.',
      'Aus diesen Jahren stammt die Erkenntnis, auf der Mirano beruht – keine Kritik an großen Organisationen, sondern eine Mechanik, die man aus der Nähe gut beobachten kann: Je größer ein Team wird, desto schwerer wird es, jedes Profil persönlich zu kennen und für jede Besetzung selbst einstehen zu können. Genau dort entscheidet sich aber, ob am Ende geliefert wird.',
      '2025 entsteht daraus Mirano Solutions in Zagreb – bewusst klein angelegt: ein Pool von maximal 40 Experten, jedes Profil persönlich bekannt, senior-geführte Teams aus der EU für den DACH-Markt, kurze Wege bis zum Gründer. Dazu eigene Produkte – nicht als Schaufenster, sondern weil ehrlicher kalkuliert, wer selbst betreibt, was er baut.',
      'Seit 2026 ist PLIMA live, die eigene SaaS-Plattform, und in München unterstützt Mirano einen Versicherungskonzern. Genauso gehört dazu, dass das Team kleinere kroatische Unternehmen bei Digitalisierung und Website-Relaunches begleitet. Große wie kleine Projekte messen sich an derselben Frage wie 2008: Am Ende zählt, was läuft.',
    ],
    milestonesLabel: 'Der Weg',
    milestones: [
      ['2008', 'Start in der IT: Systemintegration & Netzwerk-Security'],
      ['2018', 'SAP-Testmanagement bei einer Premium-Automobilmarke in München'],
      ['2020', 'CPUX-F-Zertifizierung · UX-Innovationsprojekt bei der Automobilmarke, später Projektleitung'],
      ['2021', 'Erster Einsatz in Zagreb: Nearshore über PROCON IT'],
      ['2022–2025', 'Direkt bei der Holding angestellt: IT-Infrastruktur, Recruiting & Strategie – Team auf 100+ Mitarbeitende'],
      ['2025', 'Gründung Mirano Solutions d.o.o. in Zagreb'],
      ['2026', 'PLIMA live · Engagement bei Münchner Versicherungskonzern · Team wächst'],
    ],
    certsLabel: 'Zertifizierungen (Auswahl)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn-Profil →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Prinzipien',
    principlesTitle: 'Woran wir uns messen lassen',
    principles: [
      ['Max. 40 Experten', 'Wir begrenzen den Pool bewusst. Jedes Profil ist uns persönlich bekannt – keine CV-Datenbanken.'],
      ['Qualität vor Wachstum', 'Wir lehnen ein Projekt lieber ab, als es unter unserem Standard zu besetzen.'],
      ['Direkte Wege', 'Sie sprechen mit dem Gründer und den Engineers, die die Arbeit machen. Keine Account-Schicht.'],
      ['Eigene Produkte halten uns ehrlich', 'Wir shippen und betreiben eigene SaaS – deshalb wissen wir, was Lieferung wirklich kostet.'],
    ],
  },
  hr: {
    title: 'O nama – Mirano Solutions',
    desc: 'Founder-led inženjerski partner iz Zagreba: 15+ godina u IT-u, izgradnja organizacije od 100 ljudi, osnovano 2025. Maks. 40 stručnjaka.',
    eyebrow: 'O nama',
    h1: 'Founder-led, iz uvjerenja',
    lead: 'Mirano Solutions osnovan je 2025. u Zagrebu – na temelju više od 15 godina iskustva u IT-u i jednog uvjerenja: senior kvaliteta i izravna komunikacija pobjeđuju veličinu.',
    storyEyebrow: 'Priča osnivača',
    storyTitle: 'Zašto postoji Mirano',
    founderAlt: 'Armin Zalihić, osnivač Mirano Solutionsa',
    founderCaption: 'Armin Zalihić · Osnivač',
    zagrebAlt: 'Zagreb, Hrvatska',
    story: [
      'Mirano je nastao iz zapažanja koje se potvrđivalo punih petnaest godina. Priča počinje 2008. u Münchenu, gdje je Armin Zalihić – ondje i odrastao – prve godine u IT-u proveo u sistemskoj integraciji i mrežnoj sigurnosti: firewalli, mreže, sustavi koji jednostavno moraju raditi. Tko tako počne, rano nauči da se na kraju ne računa ono što je obećano – nego ono što radi.',
      '2018. put ga vodi do premium automobilske marke u Münchenu, u SAP test management. Ondje nije dovoljno da nešto funkcionira – treba moći pokazati da izdrži i pod opterećenjem i u međudjelovanju s okolnim sustavima. Kvaliteta od ambicije postaje metoda.',
      'A 2020., s certifikatom za vođenje UX projekata (CPUX-F), dolazi treća perspektiva: većina projekata ne propada zbog tehnologije, nego na mjestu gdje se ljudi susreću s njom. UX rad kod te marke počinje kao interni inovacijski projekt, u koji se uključuje preko PROCON IT-a – najprije kao član tima. Pomaže ga proširiti i kasnije preuzima vođenje projekta – prvi put odgovoran istodobno za rezultat i za ljude.',
      'Najformativnije poglavlje počinje početkom 2021. u Zagrebu, gdje njemačka IT grupa gradi svoju hrvatsku podružnicu. Otprilike godinu dana radi ondje na nearshore angažmanu preko PROCON IT-a, tvrtke iz CONET grupe; u travnju 2022. holding ga zapošljava izravno – još tri godine, do proljeća 2025. Ukupno četiri godine u kojima sudjeluje u izgradnji tvrtke od temelja: IT infrastruktura na lokaciji, zapošljavanje, razvoj ljudi, budžeti i partnerstva u dogovoru s upravom. Interni projekti služe i tome da mlađi developeri i analitičari dobiju stvarnu odgovornost. U tom razdoblju tim raste na više od 100 zaposlenih.',
      'Iz tih godina dolazi spoznaja na kojoj Mirano počiva – ne kritika velikih organizacija, nego mehanika koja se izbliza dobro vidi: što je tim veći, to je teže osobno poznavati svaki profil i osobno stajati iza svake kadrovske odluke. A upravo se ondje odlučuje hoće li na kraju biti isporučeno.',
      '2025. iz toga je nastao Mirano Solutions u Zagrebu – namjerno malen: pool od najviše 40 stručnjaka, svaki profil osobno poznat, timovi vođeni seniorima iz EU-a za DACH tržište, kratak put do osnivača. Uz to i vlastiti proizvodi – ne kao izlog, nego zato što poštenije računa onaj tko sam održava ono što gradi.',
      'Od 2026. PLIMA, vlastita SaaS platforma, je live, a u Münchenu Mirano podržava osiguravajući koncern. Jednako je dio tvrtke i podrška manjim hrvatskim tvrtkama u digitalizaciji i redizajnu web stranica. Veliki i mali projekti mjere se istim pitanjem kao 2008. – na kraju se računa ono što radi.',
    ],
    milestonesLabel: 'Put',
    milestones: [
      ['2008', 'Početak u IT-u: sistemska integracija i mrežna sigurnost'],
      ['2018', 'SAP test management kod premium automobilske marke u Münchenu'],
      ['2020', 'CPUX-F certifikat · UX inovacijski projekt kod automobilske marke, kasnije vođenje projekta'],
      ['2021', 'Prvi angažman u Zagrebu: nearshore preko PROCON IT-a'],
      ['2022–2025', 'Izravno zaposlen u holdingu: IT infrastruktura, zapošljavanje i strategija – tim od 100+ zaposlenih'],
      ['2025', 'Osnivanje Mirano Solutions d.o.o. u Zagrebu'],
      ['2026', 'PLIMA live · angažman kod minhenskog osiguravajućeg koncerna · tim raste'],
    ],
    certsLabel: 'Certifikati (izbor)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn profil →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Načela',
    principlesTitle: 'Po čemu se mjerimo',
    principles: [
      ['Maks. 40 stručnjaka', 'Pool svjesno ograničavamo. Svaki profil osobno poznajemo – bez CV baza.'],
      ['Kvaliteta ispred rasta', 'Radije odbijemo projekt nego da ga popunimo ispod svog standarda.'],
      ['Izravna komunikacija', 'Razgovarate s osnivačem i inženjerima koji rade posao. Bez posrednika.'],
      ['Vlastiti proizvodi drže nas iskrenima', 'Isporučujemo i održavamo vlastiti SaaS – zato znamo što isporuka stvarno košta.'],
    ],
  },
};
const t = copy[lang];
---

<Base title={t.title} description={t.desc}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="container story-grid">
      <div class="story-head reveal">
        <span class="eyebrow" style="display:block;margin-bottom:1rem">{t.storyEyebrow}</span>
        <h2 style="margin-bottom:1.25rem">{t.storyTitle}</h2>
      </div>
      <div class="story-body reveal">
        <figure class="founder-figure">
          <img src="/images/armin.jpg" alt={t.founderAlt} width="653" height="736" />
          <figcaption>{t.founderCaption}</figcaption>
        </figure>
        {t.story.slice(0, 3).map((p: string) => <p class="story-p">{p}</p>)}
        <figure class="zagreb-figure">
          <img src="/images/zagreb-atmosphere.jpg" alt={t.zagrebAlt} width="770" height="900" loading="lazy" />
        </figure>
        {t.story.slice(3).map((p: string) => <p class="story-p">{p}</p>)}
        <a class="linkedin-link" href={t.linkedinUrl} target="_blank" rel="noopener">{t.linkedinLabel}</a>
      </div>
      <aside class="founder-side reveal">
        <div class="path-card">
          <span class="milestones-label">{t.milestonesLabel}</span>
          <ol class="milestones">
            {
              t.milestones.map(([year, text]: [string, string]) => (
                <li>
                  <span class="ms-year">{year}</span>
                  <span class="ms-text">{text}</span>
                </li>
              ))
            }
          </ol>
          <div class="certs">
            <span class="certs-label">{t.certsLabel}</span>
            <ul class="certs-list">
              {t.certs.map((c: string) => <li class="cert-chip">{c}</li>)}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-limestone principles-section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.principlesEyebrow}</span>
        <h2>{t.principlesTitle}</h2>
      </div>
      <div class="principles-grid">
        {
          t.principles.map(([h, d]: [string, string]) => (
            <div class="card principle reveal">
              <h3>{h}</h3>
              <p>{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBox />
</Base>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 0 3.5rem;
    align-items: start;
  }
  /* Überschrift nur in der Textspalte (Zeile 1); Text und Path-Box teilen sich
     Zeile 2 und beginnen dadurch auf gleicher Höhe – die Box schwebt nicht
     mehr auf Eyebrow-Niveau über dem Text. */
  .story-head {
    grid-column: 1;
    grid-row: 1;
  }
  .story-body {
    grid-column: 1;
    grid-row: 2;
  }
  .story-p {
    color: var(--mirano-slate);
    margin-bottom: 1.1rem;
  }
  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--mirano-orange-deep);
    text-decoration: none;
  }
  .linkedin-link:hover {
    text-decoration: underline;
  }
  .founder-figure {
    float: right;
    width: 44%;
    max-width: 230px;
    margin: 0.25rem 0 1.25rem 1.75rem;
  }
  .founder-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-card);
    border: 1px solid var(--mirano-border);
  }
  .founder-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .zagreb-figure {
    float: left;
    clear: both;
    width: 38%;
    max-width: 200px;
    aspect-ratio: 3 / 4;
    margin: 0.25rem 1.75rem 1.25rem 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--mirano-border);
  }
  .zagreb-figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder-side {
    grid-column: 2;
    grid-row: 2;
    /* Header ist sticky (92px hoch) – Spalte wandert unterhalb davon mit */
    position: sticky;
    top: calc(92px + 1.5rem);
  }
  @media (max-width: 1080px) {
    .founder-side {
      /* Header ist ab hier nur 78px hoch */
      top: calc(78px + 1.5rem);
    }
  }
  .principles-section {
    padding-top: 2.5rem;
  }
  .path-card {
    background: var(--mirano-white);
    border: 1px solid var(--mirano-border);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.75rem 1.6rem;
    display: grid;
    gap: 1.1rem;
  }
  .milestones-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-orange-deep);
  }
  .milestones {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .milestones li {
    position: relative;
    padding: 0 0 1.2rem 1.6rem;
  }
  .milestones li:last-child {
    padding-bottom: 0;
  }
  /* Punkt auf der Zeitachse */
  .milestones li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--mirano-white);
    border: 2px solid var(--mirano-orange-deep);
  }
  /* Aktuelle Station (letzter Eintrag) ist gefüllt */
  .milestones li:last-child::before {
    background: var(--mirano-orange-deep);
  }
  /* Verbindungslinie zwischen den Punkten */
  .milestones li::after {
    content: '';
    position: absolute;
    left: 5px;
    top: calc(0.3rem + 15px);
    bottom: 0.15rem;
    width: 1px;
    background: var(--mirano-border);
  }
  .milestones li:last-child::after {
    display: none;
  }
  .ms-year {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--mirano-ink);
    margin-bottom: 0.15rem;
  }
  .ms-text {
    display: block;
    font-size: 0.9375rem;
    color: var(--mirano-slate);
  }
  .certs {
    display: grid;
    gap: 0.6rem;
    border-top: 1px solid var(--mirano-border);
    padding-top: 1.1rem;
  }
  .certs-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .certs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cert-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--mirano-muted);
    background: var(--mirano-porcelain);
    border: 1px solid var(--mirano-border);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .principle {
    padding: 1.75rem;
    display: grid;
    gap: 0.6rem;
  }
  .principle h3 {
    font-size: 1.0625rem;
  }
  .principle p {
    font-size: 0.9375rem;
    color: var(--mirano-slate);
  }
  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .story-head,
    .story-body,
    .founder-side {
      grid-column: 1;
      grid-row: auto;
    }
    .founder-side {
      position: static;
      margin-top: 2.5rem;
    }
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
