      ['2026', 'PLIMA live · Engagement bei Münchner Versicherungskonzern · Team wächst'],
    ],
    certsLabel: 'Zertifizierungen (Auswahl)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn-Profil →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Prinzipien',
    principlesTitle: 'Woran wir uns messen lassen',
    principles: [
      ['Max. 40 Experten', 'Wir begrenzen den Pool bewusst. Jedes Profil ist uns persönlich bekannt – keine CV-Datenbanken.'],
      ['Qualität vor Wachstum', 'Wir lehnen ein Projekt lieber ab, als es unter unserem Standard zu besetzen.'],
      ['Direkte Wege', 'Sie sprechen mit dem Gründer und den Engineers, die die Arbeit machen. Keine Account-Schicht.'],
      ['Eigene Produkte halten uns ehrlich', 'Wir shippen und betreiben eigene SaaS – deshalb wissen wir, was Lieferung wirklich kostet.'],
    ],
  },
  hr: {
    title: 'O nama – Mirano Solutions',
    desc: 'Founder-led inženjerski partner iz Zagreba: 15+ godina u IT-u, izgradnja organizacije od 100 ljudi, osnovano 2025. Maks. 40 stručnjaka.',
    eyebrow: 'O nama',
    h1: 'Founder-led, iz uvjerenja',
    lead: 'Mirano Solutions osnovan je 2025. u Zagrebu – na temelju više od 15 godina iskustva u IT-u i jednog uvjerenja: senior kvaliteta i izravna komunikacija pobjeđuju veličinu.',
    storyEyebrow: 'Priča osnivača',
    storyTitle: 'Zašto postoji Mirano',
    founderAlt: 'Armin Zalihić, osnivač Mirano Solutionsa',
    founderCaption: 'Armin Zalihić · Osnivač',
    zagrebAlt: 'Zagreb, Hrvatska',
    story: [
      'Mnoge tvrtke prepoznaju taj obrazac iz ranijih pokušaja nearshoringa: uvjerljivo na početku, na kraju zamjenjivi tim bez pravog sugovornika. Mirano je svjestan odgovor na to.',
      'Armin Zalihić u IT-u je od 2008.: sistemska integracija i mrežna sigurnost, potom SAP test management za premium automobilski koncern, pa UX-certificirano vođenje projekata. Četiri godine, od 2021. do 2025., aktivno oblikuje – uključujući stratešku koordinaciju, u bliskom dogovoru s upravom – kako njemačka IT grupa s više od 1.900 zaposlenih gradi svoju zagrebačku podružnicu na više od 100 zaposlenih na terenu. Upravo se ondje pokazuje spoznaja na kojoj Mirano počiva: što je tim veći, to je teže osobno poznavati svaki profil i osobno stajati iza svake kadrovske odluke.',
      'Zato 2025. osniva Mirano – svjesno malen: najviše 40 stručnjaka, svaki profil osobno poznat, bez posrednika između klijenta i osnivača. Vlastiti proizvodi poput PLIME brinu da Mirano zna što isporuka stvarno košta – ne samo što se tvrdi. Bio to osiguravajući koncern u Münchenu ili srednje poduzeće u Hrvatskoj: na kraju se računa isto pitanje kao 2008. – radi li?',
      'Isto tako, dio toga je i podrška manjim hrvatskim tvrtkama u digitalizaciji i redizajnu web stranica.',
    ],
    milestonesLabel: 'Put',
    milestones: [
      ['2008', 'Početak u IT-u u tvrtki Mawoh GmbH: sistemska integracija i mrežna sigurnost'],
      ['2018', 'SAP test management preko PROCON IT-a kod premium automobilskog proizvođača u Münchenu'],
      ['2020', 'CPUX-F certifikat · pokrenuo UX inovacijski projekt, izgradio ga timom i projektima, kasnije vođenje projekta'],
      ['2021', 'Prvi angažman u Zagrebu: nearshore preko PROCON IT-a'],
      ['2022–2025', 'Izravno zaposlen u CONET-u: IT infrastruktura, zapošljavanje i strategija – tim od 100+ zaposlenih'],
      ['2025', 'Osnivanje Mirano Solutions d.o.o. u Zagrebu'],
      ['2026', 'PLIMA live · angažman kod minhenskog osiguravajućeg koncerna · tim raste'],
    ],
    certsLabel: 'Certifikati (izbor)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn profil →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Načela',
    principlesTitle: 'Po čemu se mjerimo',
    principles: [
      ['Maks. 40 stručnjaka', 'Pool svjesno ograničavamo. Svaki profil osobno poznajemo – bez CV baza.'],
      ['Kvaliteta ispred rasta', 'Radije odbijemo projekt nego da ga popunimo ispod svog standarda.'],
      ['Izravna komunikacija', 'Razgovarate s osnivačem i inženjerima koji rade posao. Bez posrednika.'],
      ['Vlastiti proizvodi drže nas iskrenima', 'Isporučujemo i održavamo vlastiti SaaS – zato znamo što isporuka stvarno košta.'],
    ],
  },
};
const t = copy[lang];
---

<Base title={t.title} description={t.desc}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="container story-grid">
      <div class="story-heading section-head reveal">
        <span class="eyebrow">{t.storyEyebrow}</span>
        <h2>{t.storyTitle}</h2>
      </div>
      <p class="story-lead reveal">{t.story[0]}</p>
      <div class="story-media story-media--portrait reveal">
        <figure class="founder-figure">
          <img src="/images/armin.jpg" alt={t.founderAlt} width="653" height="736" loading="lazy" />
          <figcaption>{t.founderCaption}</figcaption>
        </figure>
        <div class="story-media-text"><p class="story-p">{t.story[1]}</p></div>
      </div>
      <div class="story-media story-media--zagreb reveal">
        <figure class="zagreb-figure">
          <img src="/images/zagreb-atmosphere.jpg" alt={t.zagrebAlt} width="770" height="900" loading="lazy" />
        </figure>
        <div class="story-media-text"><p class="story-p">{t.story[2]}</p></div>
      </div>
      {/* Restliche Absätze – aktuell der Schlusssatz – plus LinkedIn-Link, unter
          dem Zagreb-Bild auf voller Spaltenbreite. Eigene Grid-Zeile, bewusst
          AUSSERHALB der Spanne von .founder-side (die endet an der Unterkante
          des Zagreb-Bilds, siehe .founder-side). */}
      <div class="story-outro reveal">
        {t.story.slice(3).map((p: string) => <p class="story-p">{p}</p>)}
        <a class="linkedin-link" href={t.linkedinUrl} target="_blank" rel="noopener">
          <span class="li-icon" set:html={linkedinSvg} />{t.linkedinLabel}
        </a>
      </div>
      <aside class="founder-side reveal">
        <div class="path-card">
          <span class="milestones-label">{t.milestonesLabel}</span>
          <ol class="milestones">
            {
              t.milestones.map(([year, text]: [string, string]) => (
                <li>
                  <span class="ms-year">{year}</span>
                  <span class="ms-text">{text}</span>
                </li>
              ))
            }
          </ol>
          <div class="certs">
            <span class="certs-label">{t.certsLabel}</span>
            <ul class="certs-list">
              {t.certs.map((c: string) => <li class="cert-chip">{c}</li>)}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-limestone principles-section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.principlesEyebrow}</span>
        <h2>{t.principlesTitle}</h2>
      </div>
      <div class="principles-grid">
        {
          t.principles.map(([h, d]: [string, string]) => (
            <div class="card info-card reveal">
              <h3>{h}</h3>
              <p>{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBox />
</Base>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 0 3.5rem;
    align-items: start;
  }
  /* Auftakt bleibt in Spalte 1: dadurch endet die Textzeile exakt an der rechten
     Kante des Gründerfotos (beide enden am rechten Rand der linken Spalte) statt
     wie vorher 83px darüber hinaus in die Sidebar-Spalte zu laufen. Die Path-Box
     steigt trotzdem nicht auf Eyebrow-Niveau, weil sie fest in Zeile 2 sitzt.
     .section-head liefert max-width 46rem (greift erst im einspaltigen Layout)
     und den Eyebrow→H2→Text-Stagger. */
  .story-heading {
    grid-column: 1;
    grid-row: 1;
    /* h2 liefert per .section-head h2 bereits 1rem Abstand zum Lead-Absatz
       darunter – die große .section-head-Basis (3.5rem) wird hier bewusst
       überschrieben. */
    margin-bottom: 0;
  }
  .story-lead {
    grid-column: 1;
    grid-row: 2;
    color: var(--mirano-slate);
    margin-bottom: 2.5rem;
    text-wrap: pretty;
  }
  /* Eine Quelle für die Bildspalte – Kachelbreite UND Lesespaltenbreite leiten
     sich beide hiervon ab, damit sie nicht auseinanderlaufen können. Auf
     .story-grid statt .story-body, weil die Media-Blöcke jetzt direkte
     Grid-Kinder sind (für die .founder-side-Spanne, s.u.). */
  .story-grid {
    --media-col: clamp(150px, 34%, 230px);
    --media-gap: 1.75rem;
  }
  .story-media--portrait {
    grid-row: 3;
  }
  .story-media--zagreb {
    grid-row: 4;
  }
  .story-outro {
    grid-column: 1;
    grid-row: 5;
    margin-top: 1.75rem;
  }
  .story-p {
    color: var(--mirano-slate);
    margin-bottom: 1.1rem;
    text-wrap: pretty;
  }

  /* Bild + zugehöriger Text als zwei echte Spalten – ersetzt den früheren
     float-Textumfluss. Die Bildspalte ist fluid (clamp), damit die Textspalte
     im Bereich 901–1080px nicht zusammengedrückt wird: dort ist das Grid noch
     zweispaltig, die linke Spalte aber nur ~460px breit. */
  .story-media {
    grid-column: 1;
    display: grid;
    gap: 0 var(--media-gap);
    align-items: start;
    margin-bottom: 1.75rem;
  }
  /* Trailing-Abstand zum Schlussabsatz wandert zu .story-outro (margin-top) –
     sonst würde er in Zeile 4 mitgezählt und .founder-side ragte über die
     Bildkante hinaus. Compound-Selektor nötig, um .story-media zu überstimmen. */
  .story-media.story-media--zagreb {
    margin-bottom: 0;
  }
  /* Beide Blöcke teilen sich Spaltenmaß und Anordnung (Text links, Bild rechts).
     Vorher hatten sie unterschiedliche clamp()-Werte und liefen dadurch in
     Bild- UND Textbreite auseinander. DOM bleibt Bild-zuerst, die Position
     kommt über grid-column – so folgt die Mobile-Stapelung (Bild über Text)
     weiterhin allein aus der DOM-Reihenfolge. */
  .story-media--portrait,
  .story-media--zagreb {
    grid-template-columns: minmax(0, 1fr) var(--media-col);
  }
  .story-media--portrait .story-media-text,
  .story-media--zagreb .story-media-text {
    grid-column: 1;
    grid-row: 1;
  }
  .story-media--portrait .founder-figure,
  .story-media--zagreb .zagreb-figure {
    grid-column: 2;
    grid-row: 1;
  }
  .story-media-text > :last-child {
    margin-bottom: 0;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--mirano-orange-deep);
    text-decoration: none;
  }
  .linkedin-link:hover {
    text-decoration: underline;
  }
  /* Per set:html eingefügtes SVG trägt kein Astro-Scope-Attribut – :global()
     nötig, genau wie bei .tech-icon in TechBand.astro. */
  .li-icon {
    display: inline-flex;
    flex: none;
  }
  .li-icon :global(svg) {
    display: block;
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
  .founder-figure {
    margin: 0;
  }
  .founder-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-card);
    border: 1px solid var(--mirano-border);
  }
  .founder-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .zagreb-figure {
    /* Gleiches Format wie das Porträt (dort auf dem img), damit beide Kacheln
       identisch groß sind. Nebeneffekt: 4/5 beschneidet die Quelle (770×900,
       0.856) nur um 6.5% in der Breite statt 12.4% bei 3/4 – das Motiv ist
       zentriert, ein object-position-Eingriff ist daher nicht nötig. */
    aspect-ratio: 4 / 5;
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--mirano-border);
  }
  .zagreb-figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder-side {
    grid-column: 2;
    /* Beginnt auf Höhe des Lead-Absatzes (Zeile 2 – nicht der Eyebrow/H2 in
       Zeile 1) und endet exakt an der Unterkante des Zagreb-Bilds (Ende
       Zeile 4). Die Schlussabsätze + LinkedIn-Link (Zeile 5) liegen bewusst
       außerhalb der Spanne. */
    grid-row: 2 / 5;
    /* Header ist sticky (92px hoch) – Spalte wandert unterhalb davon mit */
    position: sticky;
    top: calc(92px + 1.5rem);
  }
  @media (max-width: 1080px) {
    .founder-side {
      /* Header ist ab hier nur 78px hoch */
      top: calc(78px + 1.5rem);
    }
  }
  .principles-section {
    padding-top: 2.5rem;
  }
  .path-card {
    background: var(--mirano-white);
    border: 1px solid var(--mirano-border);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.75rem 1.6rem;
    display: grid;
    gap: 1.1rem;
  }
  .milestones-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-orange-deep);
  }
  .milestones {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .milestones li {
    position: relative;
    padding: 0 0 1.2rem 1.6rem;
  }
  .milestones li:last-child {
    padding-bottom: 0;
  }
  /* Punkt auf der Zeitachse */
  .milestones li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--mirano-white);
    border: 2px solid var(--mirano-orange-deep);
    opacity: 0;
    transform: scale(0);
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
