---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBox from '../components/CtaBox.astro';
import { getLang, type Lang } from '../i18n';
const lang = getLang(Astro.currentLocale);

// LinkedIn fehlt in simple-icons (dort auf Anfrage der Marke entfernt – 3447
// Icons, kein Treffer) – offizielles "in"-Quadrat daher als handgebautes
// Inline-SVG, einfarbig über currentColor. Gleiche set:html-Technik wie das
// Sparkle-Icon in TechBand.astro. Rein dekorativ (aria-hidden), weil der
// Linktext die Bedeutung schon trägt.
const linkedinSvg =
  '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>';

const copy: Record<Lang, any> = {
  en: {
    title: 'About us – Mirano Solutions',
    desc: 'Founder-led engineering partner from Zagreb: 15+ years in IT, buildup of a 100-person organization, founded 2025. Max. 40 experts, quality over growth.',
    eyebrow: 'About us',
    h1: 'Founder-led, by design',
    lead: 'Mirano Solutions was founded in 2025 in Zagreb – built on 15+ years of IT experience and one conviction: senior quality and direct communication beat scale.',
    storyEyebrow: 'The founder story',
    storyTitle: 'Why Mirano exists',
    founderAlt: 'Armin Zalihić, founder of Mirano Solutions',
    founderCaption: 'Armin Zalihić · Founder',
    zagrebAlt: 'Zagreb, Croatia',
    story: [
      'Many companies recognize this pattern from earlier nearshoring attempts: convincing at first, an interchangeable team with no real point of contact by the end. Mirano is the deliberate answer to that.',
      'Armin Zalihić has been in IT since 2008: systems integration and network security, later SAP test management for a premium automotive group, then UX-certified project leadership. For four years, 2021 to 2025, he played a defining role – strategic steering included, in close coordination with executive management – as a German IT group of more than 1,900 employees built up its Zagreb branch to more than 100 people on the ground. That is exactly where the insight Mirano is built on becomes visible: the bigger a team gets, the harder it becomes to know every profile personally and to stand behind every staffing decision yourself.',
      'That’s why he founded Mirano in 2025 – deliberately small: a maximum of 40 experts, every profile personally known, no account layer between client and founder. Products of our own, like PLIMA, keep Mirano honest about what delivery actually costs – not just what gets claimed. Whether it’s an insurance group in Munich or an SME in Croatia: in the end, the same question counts as in 2008 – does it run?',
      'Also part of it: Mirano supports smaller Croatian businesses with digitization and website relaunches.',
    ],
    milestonesLabel: 'The path',
    milestones: [
      ['2008', 'Start in IT: systems integration & network security'],
      ['2018', 'SAP test management at a premium automotive brand in Munich'],
      ['2020', 'CPUX-F certification · UX innovation project at the automotive brand, later project lead'],
      ['2021', 'First assignment in Zagreb: nearshore through PROCON IT'],
      ['2022–2025', 'Directly employed by the holding: IT infrastructure, recruiting & strategy – team built up to 100+ employees'],
      ['2025', 'Founded Mirano Solutions d.o.o. in Zagreb'],
      ['2026', 'PLIMA live · engagement at a Munich insurance group · team growing'],
    ],
    certsLabel: 'Certifications (selected)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn profile →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Principles',
    principlesTitle: 'What we hold ourselves to',
    principles: [
      ['Max. 40 experts', 'We cap the pool on purpose. Every profile is known to us personally – no CV databases.'],
      ['Quality over growth', 'We would rather decline a project than staff it below our standard.'],
      ['Direct communication', 'You talk to the founder and to the engineers doing the work. No account layer.'],
      ['Own products keep us honest', 'We ship and operate our own SaaS – so we know what delivery really costs.'],
    ],
  },
  de: {
    title: 'Über Mirano – Mirano Solutions',
    desc: 'Founder-led Engineering-Partner aus Zagreb: 15+ Jahre IT, Aufbau einer 100-Personen-Organisation, gegründet 2025. Max. 40 Experten, Qualität vor Wachstum.',
    eyebrow: 'Über Mirano',
    h1: 'Founder-led, aus Überzeugung',
    lead: 'Mirano Solutions wurde 2025 in Zagreb gegründet – auf Basis von über 15 Jahren IT-Erfahrung und einer Überzeugung: Senior-Qualität und direkte Wege schlagen Größe.',
    storyEyebrow: 'Die Founder-Story',
    storyTitle: 'Warum es Mirano gibt',
    founderAlt: 'Armin Zalihić, Gründer von Mirano Solutions',
    founderCaption: 'Armin Zalihić · Gründer',
    zagrebAlt: 'Zagreb, Kroatien',
    story: [
      'Viele Unternehmen kennen das Muster aus früheren Nearshoring-Versuchen: Am Anfang überzeugend, am Ende ein austauschbares Team ohne echten Ansprechpartner. Mirano ist die bewusste Antwort darauf.',
      'Armin Zalihić ist seit 2008 in der IT: Systemintegration und Netzwerk-Security, später SAP-Testmanagement für einen Premium-Automobilkonzern, dann UX-zertifizierte Projektleitung. Vier Jahre, 2021 bis 2025, gestaltet er maßgeblich mit – strategische Steuerung inklusive, in enger Abstimmung mit der Geschäftsführung – wie eine deutsche IT-Gruppe mit über 1.900 Mitarbeitenden ihre Zagreb-Niederlassung auf über 100 Mitarbeitende vor Ort aufbaut. Genau dort zeigt sich die Erkenntnis, auf der Mirano beruht: Je größer ein Team wird, desto schwerer wird es, jedes Profil persönlich zu kennen und für jede Besetzung selbst einzustehen.',
      '2025 gründet er deshalb Mirano – bewusst klein: maximal 40 Experten, jedes Profil persönlich bekannt, kein Account-Management zwischen Kunde und Gründer. Eigene Produkte wie PLIMA sorgen dafür, dass Mirano weiß, was Lieferung wirklich kostet – nicht nur behauptet. Ob Versicherungskonzern in München oder Mittelständler in Kroatien: Am Ende zählt dieselbe Frage wie 2008 – läuft es?',
      'Ebenso Teil davon: Mirano begleitet auch kleinere kroatische Unternehmen bei Digitalisierung und Website-Relaunches.',
    ],
    milestonesLabel: 'Der Weg',
    milestones: [
      ['2008', 'Start in der IT: Systemintegration & Netzwerk-Security'],
      ['2018', 'SAP-Testmanagement bei einer Premium-Automobilmarke in München'],
      ['2020', 'CPUX-F-Zertifizierung · UX-Innovationsprojekt bei der Automobilmarke, später Projektleitung'],
      ['2021', 'Erster Einsatz in Zagreb: Nearshore über PROCON IT'],
      ['2022–2025', 'Direkt bei der Holding angestellt: IT-Infrastruktur, Recruiting & Strategie – Team auf 100+ Mitarbeitende'],
      ['2025', 'Gründung Mirano Solutions d.o.o. in Zagreb'],
      ['2026', 'PLIMA live · Engagement bei Münchner Versicherungskonzern · Team wächst'],
    ],
    certsLabel: 'Zertifizierungen (Auswahl)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn-Profil →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Prinzipien',
    principlesTitle: 'Woran wir uns messen lassen',
    principles: [
      ['Max. 40 Experten', 'Wir begrenzen den Pool bewusst. Jedes Profil ist uns persönlich bekannt – keine CV-Datenbanken.'],
      ['Qualität vor Wachstum', 'Wir lehnen ein Projekt lieber ab, als es unter unserem Standard zu besetzen.'],
      ['Direkte Wege', 'Sie sprechen mit dem Gründer und den Engineers, die die Arbeit machen. Keine Account-Schicht.'],
      ['Eigene Produkte halten uns ehrlich', 'Wir shippen und betreiben eigene SaaS – deshalb wissen wir, was Lieferung wirklich kostet.'],
    ],
  },
  hr: {
    title: 'O nama – Mirano Solutions',
    desc: 'Founder-led inženjerski partner iz Zagreba: 15+ godina u IT-u, izgradnja organizacije od 100 ljudi, osnovano 2025. Maks. 40 stručnjaka.',
    eyebrow: 'O nama',
    h1: 'Founder-led, iz uvjerenja',
    lead: 'Mirano Solutions osnovan je 2025. u Zagrebu – na temelju više od 15 godina iskustva u IT-u i jednog uvjerenja: senior kvaliteta i izravna komunikacija pobjeđuju veličinu.',
    storyEyebrow: 'Priča osnivača',
    storyTitle: 'Zašto postoji Mirano',
    founderAlt: 'Armin Zalihić, osnivač Mirano Solutionsa',
    founderCaption: 'Armin Zalihić · Osnivač',
    zagrebAlt: 'Zagreb, Hrvatska',
    story: [
      'Mnoge tvrtke prepoznaju taj obrazac iz ranijih pokušaja nearshoringa: uvjerljivo na početku, na kraju zamjenjivi tim bez pravog sugovornika. Mirano je svjestan odgovor na to.',
      'Armin Zalihić u IT-u je od 2008.: sistemska integracija i mrežna sigurnost, potom SAP test management za premium automobilski koncern, pa UX-certificirano vođenje projekata. Četiri godine, od 2021. do 2025., aktivno oblikuje – uključujući stratešku koordinaciju, u bliskom dogovoru s upravom – kako njemačka IT grupa s više od 1.900 zaposlenih gradi svoju zagrebačku podružnicu na više od 100 zaposlenih na terenu. Upravo se ondje pokazuje spoznaja na kojoj Mirano počiva: što je tim veći, to je teže osobno poznavati svaki profil i osobno stajati iza svake kadrovske odluke.',
      'Zato 2025. osniva Mirano – svjesno malen: najviše 40 stručnjaka, svaki profil osobno poznat, bez posrednika između klijenta i osnivača. Vlastiti proizvodi poput PLIME brinu da Mirano zna što isporuka stvarno košta – ne samo što se tvrdi. Bio to osiguravajući koncern u Münchenu ili srednje poduzeće u Hrvatskoj: na kraju se računa isto pitanje kao 2008. – radi li?',
      'Isto tako, dio toga je i podrška manjim hrvatskim tvrtkama u digitalizaciji i redizajnu web stranica.',
    ],
    milestonesLabel: 'Put',
    milestones: [
      ['2008', 'Početak u IT-u: sistemska integracija i mrežna sigurnost'],
      ['2018', 'SAP test management kod premium automobilske marke u Münchenu'],
      ['2020', 'CPUX-F certifikat · UX inovacijski projekt kod automobilske marke, kasnije vođenje projekta'],
      ['2021', 'Prvi angažman u Zagrebu: nearshore preko PROCON IT-a'],
      ['2022–2025', 'Izravno zaposlen u holdingu: IT infrastruktura, zapošljavanje i strategija – tim od 100+ zaposlenih'],
      ['2025', 'Osnivanje Mirano Solutions d.o.o. u Zagrebu'],
      ['2026', 'PLIMA live · angažman kod minhenskog osiguravajućeg koncerna · tim raste'],
    ],
    certsLabel: 'Certifikati (izbor)',
    certs: ['Cisco CCNA (2011)', 'Juniper AJSA (2012)', 'ITIL Foundation', 'UXQB CPUX-F (2019)'],
    linkedinLabel: 'LinkedIn profil →',
    linkedinUrl: 'https://de.linkedin.com/in/armin-zalihic-53a727201',
    principlesEyebrow: 'Načela',
    principlesTitle: 'Po čemu se mjerimo',
    principles: [
      ['Maks. 40 stručnjaka', 'Pool svjesno ograničavamo. Svaki profil osobno poznajemo – bez CV baza.'],
      ['Kvaliteta ispred rasta', 'Radije odbijemo projekt nego da ga popunimo ispod svog standarda.'],
      ['Izravna komunikacija', 'Razgovarate s osnivačem i inženjerima koji rade posao. Bez posrednika.'],
      ['Vlastiti proizvodi drže nas iskrenima', 'Isporučujemo i održavamo vlastiti SaaS – zato znamo što isporuka stvarno košta.'],
    ],
  },
};
const t = copy[lang];
---

<Base title={t.title} description={t.desc}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="container story-grid">
      <div class="story-intro section-head reveal">
        <span class="eyebrow">{t.storyEyebrow}</span>
        <h2>{t.storyTitle}</h2>
        <p>{t.story[0]}</p>
      </div>
      <div class="story-body reveal">
        <div class="story-media story-media--portrait">
          <figure class="founder-figure">
            <img src="/images/armin.jpg" alt={t.founderAlt} width="653" height="736" loading="lazy" />
            <figcaption>{t.founderCaption}</figcaption>
          </figure>
          <div class="story-media-text"><p class="story-p">{t.story[1]}</p></div>
        </div>
        {/* Absätze zwischen Karriere- und Schlussabsatz laufen als normaler Fließtext */}
        {t.story.slice(2, -1).map((p: string) => <p class="story-p">{p}</p>)}
        <div class="story-media story-media--zagreb">
          <figure class="zagreb-figure">
            <img src="/images/zagreb-atmosphere.jpg" alt={t.zagrebAlt} width="770" height="900" loading="lazy" />
          </figure>
          <div class="story-media-text"><p class="story-p">{t.story.at(-1)}</p></div>
        </div>
        <a class="linkedin-link" href={t.linkedinUrl} target="_blank" rel="noopener">
          <span class="li-icon" set:html={linkedinSvg} />{t.linkedinLabel}
        </a>
      </div>
      <aside class="founder-side reveal">
        <div class="path-card">
          <span class="milestones-label">{t.milestonesLabel}</span>
          <ol class="milestones">
            {
              t.milestones.map(([year, text]: [string, string]) => (
                <li>
                  <span class="ms-year">{year}</span>
                  <span class="ms-text">{text}</span>
                </li>
              ))
            }
          </ol>
          <div class="certs">
            <span class="certs-label">{t.certsLabel}</span>
            <ul class="certs-list">
              {t.certs.map((c: string) => <li class="cert-chip">{c}</li>)}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-limestone principles-section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.principlesEyebrow}</span>
        <h2>{t.principlesTitle}</h2>
      </div>
      <div class="principles-grid">
        {
          t.principles.map(([h, d]: [string, string]) => (
            <div class="card info-card reveal">
              <h3>{h}</h3>
              <p>{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBox />
</Base>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 0 3.5rem;
    align-items: start;
  }
  /* Eyebrow, H2 und Auftaktabsatz laufen über beide Spalten (Zeile 1). Text und
     Path-Box teilen sich Zeile 2 – die Box steigt dadurch weiterhin nicht auf
     Eyebrow-Niveau, sondern beginnt erst beim Karriere-Absatz.
     .section-head liefert max-width 46rem und den Eyebrow→H2→Text-Stagger. */
  .story-intro {
    grid-column: 1 / -1;
    grid-row: 1;
    margin-bottom: 2.5rem;
  }
  .story-intro p {
    text-wrap: pretty;
  }
  .story-body {
    grid-column: 1;
    grid-row: 2;
  }
  .story-p {
    color: var(--mirano-slate);
    margin-bottom: 1.1rem;
    text-wrap: pretty;
  }

  /* Bild + zugehöriger Text als zwei echte Spalten – ersetzt den früheren
     float-Textumfluss. Die Bildspalte ist fluid (clamp), damit die Textspalte
     im Bereich 901–1080px nicht zusammengedrückt wird: dort ist das Grid noch
     zweispaltig, die linke Spalte aber nur ~460px breit. */
  .story-media {
    display: grid;
    gap: 0 1.75rem;
    align-items: start;
    margin-bottom: 1.75rem;
  }
  .story-media--portrait {
    grid-template-columns: minmax(0, 1fr) clamp(130px, 30%, 210px);
  }
  /* Porträt rechts (wie vorher float:right), Text links – DOM bleibt Bild zuerst,
     damit auf Mobile das Bild über seinem Text steht. */
  .story-media--portrait .story-media-text {
    grid-column: 1;
    grid-row: 1;
  }
  .story-media--portrait .founder-figure {
    grid-column: 2;
    grid-row: 1;
  }
  /* Zagreb links (wie vorher float:left), Text rechts. Der Schlussabsatz ist
     kurz gegen ein 3/4-hohes Bild – zentriert gelesen wirkt das als Paarung,
     oben angeschlagen bliebe darunter eine Lücke. */
  .story-media--zagreb {
    grid-template-columns: clamp(120px, 27%, 190px) minmax(0, 1fr);
    align-items: center;
  }
  .story-media-text > :last-child {
    margin-bottom: 0;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--mirano-orange-deep);
    text-decoration: none;
  }
  .linkedin-link:hover {
    text-decoration: underline;
  }
  /* Per set:html eingefügtes SVG trägt kein Astro-Scope-Attribut – :global()
     nötig, genau wie bei .tech-icon in TechBand.astro. */
  .li-icon {
    display: inline-flex;
    flex: none;
  }
  .li-icon :global(svg) {
    display: block;
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
  .founder-figure {
    margin: 0;
  }
  .founder-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-card);
    border: 1px solid var(--mirano-border);
  }
  .founder-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .zagreb-figure {
    aspect-ratio: 3 / 4;
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--mirano-border);
  }
  .zagreb-figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder-side {
    grid-column: 2;
    grid-row: 2;
    /* Header ist sticky (92px hoch) – Spalte wandert unterhalb davon mit */
    position: sticky;
    top: calc(92px + 1.5rem);
  }
  @media (max-width: 1080px) {
    .founder-side {
      /* Header ist ab hier nur 78px hoch */
      top: calc(78px + 1.5rem);
    }
  }
  .principles-section {
    padding-top: 2.5rem;
  }
  .path-card {
    background: var(--mirano-white);
    border: 1px solid var(--mirano-border);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.75rem 1.6rem;
    display: grid;
    gap: 1.1rem;
  }
  .milestones-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-orange-deep);
  }
  .milestones {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .milestones li {
    position: relative;
    padding: 0 0 1.2rem 1.6rem;
  }
  .milestones li:last-child {
    padding-bottom: 0;
  }
  /* Punkt auf der Zeitachse */
  .milestones li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--mirano-white);
    border: 2px solid var(--mirano-orange-deep);
    opacity: 0;
    transform: scale(0);
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }
  /* Aktuelle Station (letzter Eintrag) ist gefüllt */
  .milestones li:last-child::before {
    background: var(--mirano-orange-deep);
  }
  /* Verbindungslinie zwischen den Punkten – wächst beim Reinscrollen von oben nach unten */
  .milestones li::after {
    content: '';
    position: absolute;
    left: 5px;
    top: calc(0.3rem + 15px);
    bottom: 0.15rem;
    width: 1px;
    background: var(--mirano-border);
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform 0.45s linear;
  }
  .milestones li:last-child::after {
    display: none;
  }
  .milestones li > * {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  /* Staffelung wie bei der Referenzen-Timeline (ReferencesView.astro): Segment i ab i·0.35s, Punkt und Inhalt folgen */
  .milestones li:nth-child(2)::after { transition-delay: 0.35s; }
  .milestones li:nth-child(3)::after { transition-delay: 0.7s; }
  .milestones li:nth-child(4)::after { transition-delay: 1.05s; }
  .milestones li:nth-child(5)::after { transition-delay: 1.4s; }
  .milestones li:nth-child(6)::after { transition-delay: 1.75s; }
  .milestones li:nth-child(7)::after { transition-delay: 2.1s; }
  .milestones li:nth-child(2)::before { transition-delay: 0.35s; }
  .milestones li:nth-child(3)::before { transition-delay: 0.7s; }
  .milestones li:nth-child(4)::before { transition-delay: 1.05s; }
  .milestones li:nth-child(5)::before { transition-delay: 1.4s; }
  .milestones li:nth-child(6)::before { transition-delay: 1.75s; }
  .milestones li:nth-child(7)::before { transition-delay: 2.1s; }
  .milestones li:nth-child(1) > * { transition-delay: 0.15s; }
  .milestones li:nth-child(2) > * { transition-delay: 0.5s; }
  .milestones li:nth-child(3) > * { transition-delay: 0.85s; }
  .milestones li:nth-child(4) > * { transition-delay: 1.2s; }
  .milestones li:nth-child(5) > * { transition-delay: 1.55s; }
  .milestones li:nth-child(6) > * { transition-delay: 1.9s; }
  .milestones li:nth-child(7) > * { transition-delay: 2.25s; }
  /* .founder-side (bereits per Observer beobachtet, s. Base.astro) triggert die Kaskade –
     kein zusätzliches Reveal-Ziel, damit sich nichts mit dem Sticky-Verhalten überschneidet */
  .founder-side.is-visible .milestones li::after {
    transform: scaleY(1);
  }
  .founder-side.is-visible .milestones li::before {
    opacity: 1;
    transform: scale(1);
  }
  .founder-side.is-visible .milestones li > * {
    opacity: 1;
