    ],
  },
};
const t = copy[lang];
---

<Base title={t.title} description={t.desc}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="container story-grid">
      <div class="reveal">
        <span class="eyebrow" style="display:block;margin-bottom:1rem">{t.storyEyebrow}</span>
        <h2 style="margin-bottom:1.25rem">{t.storyTitle}</h2>
        {t.story.map((p: string) => <p class="story-p">{p}</p>)}
        <a class="linkedin-link" href={t.linkedinUrl} target="_blank" rel="noopener">{t.linkedinLabel}</a>
      </div>
      <div class="founder-side reveal">
        <div class="founder-photo-lg">
          <img src="/images/armin.jpg" alt="Armin Zalihic, Gründer von Mirano Solutions" width="800" height="600" />
        </div>
        <ol class="milestones">
          <span class="milestones-label">{t.milestonesLabel}</span>
          {
            t.milestones.map(([year, text]: [string, string]) => (
              <li>
                <span class="ms-year">{year}</span>
                <span class="ms-text">{text}</span>
              </li>
            ))
          }
        </ol>
        <div class="certs">
          <span class="certs-label">{t.certsLabel}</span>
          <ul class="certs-list">
            {t.certs.map((c: string) => <li class="cert-chip">{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-limestone principles-section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t.principlesEyebrow}</span>
        <h2>{t.principlesTitle}</h2>
      </div>
      <div class="principles-grid">
        {
          t.principles.map(([h, d]: [string, string]) => (
            <div class="card principle reveal">
              <h3>{h}</h3>
              <p>{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBox />
</Base>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 3.5rem;
    align-items: start;
  }
  .story-p {
    color: var(--mirano-slate);
    margin-bottom: 1.1rem;
  }
  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--mirano-orange-deep);
    text-decoration: none;
  }
  .linkedin-link:hover {
    text-decoration: underline;
  }
  .founder-side {
    display: grid;
    gap: 1.25rem;
  }
  .principles-section {
    padding-top: 2.5rem;
  }
  .founder-photo-lg {
    aspect-ratio: 2 / 1;
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .founder-photo-lg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }
  .milestones {
    list-style: none;
    padding: 1.5rem 1.75rem;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.5rem;
    background: var(--mirano-white);
    border: 1px solid var(--mirano-border);
    border-radius: var(--radius-card);
  }
  .milestones-label {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-orange-deep);
    margin-bottom: 0.25rem;
  }
  .milestones li {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 0.6rem;
    align-items: baseline;
    font-size: 0.9375rem;
  }
  .ms-year {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--mirano-ink);
  }
  .ms-text {
    color: var(--mirano-slate);
  }
  .certs {
    display: grid;
    gap: 0.6rem;
  }
  .certs-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .certs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cert-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--mirano-muted);
    background: var(--mirano-white);
    border: 1px solid var(--mirano-border);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .principle {
    padding: 1.75rem;
    display: grid;
    gap: 0.6rem;
  }
  .principle h3 {
    font-size: 1.0625rem;
  }
  .principle p {
    font-size: 0.9375rem;
    color: var(--mirano-slate);
  }
  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .milestones {
      grid-template-columns: 1fr;
    }
  }
</style>
