---
// Tech-Stack-Band. Abgeglichen mit alter Website (React, Angular, Vue, Java, Node.js,
// AWS/Azure/GCP, Docker, K8s, GitHub/GitLab/Jenkins, Terraform) + Armin-Updates:
// Claude & Cursor rein, TensorFlow raus, Vercel + Hostinger (Hosting DE) ergänzt.
import * as icons from 'simple-icons';
import { getLang, type Lang } from '../i18n';
const lang = getLang(Astro.currentLocale);

type Tech = { label: string; icon?: string; svg?: string };

// Generisches Sparkle-Icon für Chips ohne Marken-Icon; Größe/Farbe kommen wie
// bei den simple-icons aus .tech-icon :global(svg).
const sparkleSvg =
  '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><title>LLM Integration</title><path d="M10 4c.75 4.05 3.2 6.5 7.25 7.25v1.5C13.2 13.5 10.75 15.95 10 20h-1.5c-.75-4.05-3.2-6.5-7.25-7.25v-1.5C5.3 10.5 7.75 8.05 8.5 4H10Zm9.25-2c.4 2.15 1.6 3.35 3.75 3.75v1.5c-2.15.4-3.35 1.6-3.75 3.75h-1.5c-.4-2.15-1.6-3.35-3.75-3.75v-1.5c2.15-.4 3.35-1.6 3.75-3.75h1.5Z"/></svg>';

// AWS hat kein Marken-Icon in simple-icons (Amazon lässt die Nutzung des
// Logos nur unter eigener Trademark-Policy zu) – generisches Cloud-Icon
// als neutraler Platzhalter, im selben Stil wie die anderen Chips.
const cloudSvg =
  '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><title>AWS</title><path d="M19.35 10.04A7.49 7.49 0 0 0 12 4a7.49 7.49 0 0 0-7.35 6.04A5.5 5.5 0 0 0 6 21h13a5 5 0 0 0 .35-10.96Z"/></svg>';

const groups: { name: string; items: Tech[] }[] = [
  {
    name: 'Frontend',
    items: [
      { label: 'React', icon: 'siReact' },
      { label: 'Next.js', icon: 'siNextdotjs' },
      { label: 'Angular', icon: 'siAngular' },
      { label: 'Vue', icon: 'siVuedotjs' },
      { label: 'TypeScript', icon: 'siTypescript' },
    ],
  },
  {
    name: 'Backend',
    items: [
      { label: 'Node.js', icon: 'siNodedotjs' },
      { label: 'Java / Spring', icon: 'siSpringboot' },
      { label: 'Python', icon: 'siPython' },
      { label: 'PostgreSQL', icon: 'siPostgresql' },
      { label: 'GraphQL', icon: 'siGraphql' },
    ],
  },
  {
    name: 'Cloud & DevOps',
    items: [
      { label: 'AWS', svg: cloudSvg },
      { label: 'Google Cloud', icon: 'siGooglecloud' },
      { label: 'Docker', icon: 'siDocker' },
      { label: 'Kubernetes', icon: 'siKubernetes' },
      { label: 'Terraform', icon: 'siTerraform' },
      { label: 'Vercel', icon: 'siVercel' },
      { label: 'Hostinger (EU)', icon: 'siHostinger' },
    ],
  },
  {
    name: 'QA & Testing',
    items: [
      { label: 'Cypress', icon: 'siCypress' },
      { label: 'Playwright' },
      { label: 'Selenium', icon: 'siSelenium' },
      { label: 'JMeter', icon: 'siApachejmeter' },
    ],
  },
  {
    name: 'SAP',
    items: [{ label: 'SAP', icon: 'siSap' }, { label: 'SAP Test Management' }],
  },
  {
    name: 'AI',
    items: [
      { label: 'Claude', icon: 'siClaude' },
      { label: 'Cursor', icon: 'siCursor' },
      { label: 'LLM Integration', svg: sparkleSvg },
    ],
  },
  {
    name: 'Workflow',
    items: [
      { label: 'Linear', icon: 'siLinear' },
      { label: 'GitHub', icon: 'siGithub' },
    ],
  },
];

const iconSvg = (name?: string): string | null => {
  if (!name) return null;
  const icon = (icons as Record<string, { svg: string } | undefined>)[name];
  return icon?.svg ?? null;
};

const copy: Record<Lang, { eyebrow: string; h2: string }> = {
  en: { eyebrow: 'Technologies', h2: 'The stack of our expert pool' },
  de: { eyebrow: 'Technologien', h2: 'Der Stack unseres Experten-Pools' },
  hr: { eyebrow: 'Tehnologije', h2: 'Tehnološki stack našeg tima' },
};
const t = copy[lang];
---

<section class="section techband section-limestone" aria-labelledby="tech-heading">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id="tech-heading">{t.h2}</h2>
    </div>

    <div class="tech-groups">
      {
        groups.map((group) => (
          <div class="tech-group reveal">
            <span class="tech-group-name">{group.name}</span>
            <ul>
              {group.items.map((tech) => {
                const svg = tech.svg ?? iconSvg(tech.icon);
                return (
                  <li class="tech-chip">
                    {svg && <span class="tech-icon" set:html={svg} />}
                    {tech.label}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .techband {
    padding-block: 5rem;
  }
  .tech-groups {
    display: grid;
    gap: 1.75rem;
  }
  .tech-group {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    align-items: start;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--mirano-border);
  }
  .tech-group:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .tech-group-name {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-orange-deep);
    padding-top: 0.45rem;
  }
  .tech-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--mirano-slate);
    background: var(--mirano-white);
    border: 1px solid var(--mirano-border);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .tech-chip:hover {
    border-color: color-mix(in srgb, var(--mirano-orange) 45%, var(--mirano-border));
    color: var(--mirano-ink);
  }
  .tech-icon :global(svg) {
    width: 15px;
    height: 15px;
    fill: var(--mirano-muted);
  }
  .tech-chip:hover .tech-icon :global(svg) {
    fill: var(--mirano-orange);
  }

  @media (max-width: 700px) {
    .tech-group {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .tech-group-name {
      padding-top: 0;
    }
  }
</style>
