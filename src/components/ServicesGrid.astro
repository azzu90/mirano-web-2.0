---
import { getLang, l, type Lang } from '../i18n';
const lang = getLang(Astro.currentLocale);

const copy: Record<Lang, any> = {
  en: {
    eyebrow: 'Services',
    h2: 'Six ways to work with us',
    intro: 'A deliberately small pool with a high senior share – selected for quality, not volume.',
    more: 'Learn more →',
    items: [
      { href: '/services/software-engineering', title: 'Software Engineering', text: 'Web applications, platforms and integrations – as a project or managed team, from architecture to operations.' },
      { href: '/services/team-extension', title: 'Experts & Team Extension', text: 'Senior developers, testers and consultants extend your team – remote-first, starting within 5–10 business days.' },
      { href: '/services/qa-testing', title: 'QA & Testing', text: 'Test management, test automation and quality assurance – including regulated environments such as insurance.' },
      { href: '/services/managed-services', title: 'Managed Services & Support', text: 'SLA-based operations: helpdesk, infrastructure, maintenance and monitoring – ITIL-aligned, in German and English.' },
      { href: '/services/ai-automation', title: 'AI & Automation', text: 'AI consulting and hands-on integration – from LLM-based workflows to intelligent document processing. We use AI daily in our own products.' },
      { href: '/services/consulting', title: 'Consulting & Business Analysis', text: 'Business analysis, requirements management, process analysis and PMO support – including regulated environments such as insurance.' },
    ],
  },
  de: {
    eyebrow: 'Leistungen',
    h2: 'Sechs Wege, mit uns zu arbeiten',
    intro: 'Ein bewusst kleiner Pool mit hohem Senior-Anteil – ausgewählt nach Qualität, nicht nach Volumen.',
    more: 'Mehr dazu →',
    items: [
      { href: '/services/software-engineering', title: 'Software Engineering', text: 'Web-Anwendungen, Plattformen und Integrationen – als Projekt oder Managed Team, von Architektur bis Betrieb.' },
      { href: '/services/team-extension', title: 'Experten & Team Extension', text: 'Senior-Entwickler, Tester und Consultants erweitern Ihr Team – remote-first, Start in 5–10 Werktagen.' },
      { href: '/services/qa-testing', title: 'QA & Testing', text: 'Testmanagement, Testautomatisierung und Qualitätssicherung – auch in regulierten Umgebungen wie Versicherungen.' },
      { href: '/services/managed-services', title: 'Managed Services & Support', text: 'SLA-basierter Betrieb: Helpdesk, Infrastruktur, Wartung und Monitoring – ITIL-orientiert, auf Deutsch und Englisch.' },
      { href: '/services/ai-automation', title: 'AI & Automatisierung', text: 'KI-Beratung und praktische Integration – von LLM-Workflows bis zur intelligenten Dokumentenverarbeitung. Wir nutzen AI täglich in unseren eigenen Produkten.' },
      { href: '/services/consulting', title: 'Consulting & Business-Analyse', text: 'Business-Analyse, Anforderungsmanagement, Prozessanalyse und PMO-Unterstützung – auch in regulierten Umgebungen wie Versicherungen.' },
    ],
  },
  hr: {
    eyebrow: 'Usluge',
    h2: 'Šest načina suradnje s nama',
    intro: 'Svjesno mali pool s visokim udjelom seniora – biran po kvaliteti, ne po volumenu.',
    more: 'Saznajte više →',
    items: [
      { href: '/services/software-engineering', title: 'Razvoj softvera', text: 'Web aplikacije, platforme i integracije – kao projekt ili managed team, od arhitekture do produkcije.' },
      { href: '/services/team-extension', title: 'Stručnjaci i proširenje tima', text: 'Senior developeri, testeri i konzultanti proširuju vaš tim – remote-first, početak za 5–10 radnih dana.' },
      { href: '/services/qa-testing', title: 'QA i testiranje', text: 'Test management, automatizacija testiranja i osiguranje kvalitete – i u reguliranim okruženjima poput osiguranja.' },
      { href: '/services/managed-services', title: 'Managed Services i podrška', text: 'Rad po SLA modelu: helpdesk, infrastruktura, održavanje i monitoring – prema ITIL-u, na njemačkom i engleskom.' },
      { href: '/services/ai-automation', title: 'AI i automatizacija', text: 'AI savjetovanje i praktična integracija – od LLM procesa do inteligentne obrade dokumenata. AI svakodnevno koristimo u vlastitim proizvodima.' },
      { href: '/services/consulting', title: 'Konzalting i poslovna analiza', text: 'Poslovna analiza, upravljanje zahtjevima, analiza procesa i PMO podrška – i u reguliranim okruženjima poput osiguranja.' },
    ],
  },
};
const t = copy[lang];
---

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>{t.h2}</h2>
      <p>{t.intro}</p>
    </div>

    <div class="services-grid">
      {
        t.items.map((s: any) => (
          <a href={l(lang, s.href)} class="card service reveal">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="service-more" aria-hidden="true">{t.more}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .service {
    padding: 1.75rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .service:hover {
    border-color: color-mix(in srgb, var(--mirano-orange) 40%, var(--mirano-border));
    transform: translateY(-3px);
  }
  .service:active {
    transform: translateY(-1px);
  }
  .service h3 {
    font-size: 1.125rem;
  }
  .service p {
    font-size: 0.9375rem;
    color: var(--mirano-slate);
  }
  .service-more {
    margin-top: auto;
    font-weight: 600;
    font-size: var(--text-small);
    color: var(--mirano-orange-deep);
  }

  @media (max-width: 1000px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
