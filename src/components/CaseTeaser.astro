---
// Referenz-Teaser. Headsquare wird namentlich genannt (Freigabe liegt vor); Endkunde bleibt anonym.
import { getLang, l, type Lang } from '../i18n';
const lang = getLang(Astro.currentLocale);

const copy: Record<Lang, any> = {
  en: {
    eyebrow: 'References',
    h2: 'Proven, not promised',
    more: 'Read the case study →',
    cases: [
      {
        href: '/references#plima',
        eyebrow: 'Our own product · HR SaaS',
        title: 'PLIMA: from idea to launch',
        text: 'HR software for SMEs – designed, built and taken to production. Two customers now work with it daily.',
        stat: '3', statUnit: 'months', statLabel: 'idea → launch',
      },
      {
        href: '/references#insurance',
        eyebrow: 'For Headsquare · insurance group, Munich',
        title: 'Test management in live operations',
        text: 'Quality assurance in a regulated project environment – engaged since May 2026, scaling to three QA experts from Q4/2026.',
        stat: '1', statUnit: 'QA expert', statLabel: 'engaged since May 2026',
      },
    ],
  },
  de: {
    eyebrow: 'Referenzen',
    h2: 'Belegt, nicht behauptet',
    more: 'Case Study lesen →',
    cases: [
      {
        href: '/references#plima',
        eyebrow: 'Eigenes Produkt · HR-SaaS',
        title: 'PLIMA: Von der Idee zum Launch',
        text: 'HR-Software für den Mittelstand – konzipiert, entwickelt und produktiv gesetzt. Zwei Kunden arbeiten täglich damit.',
        stat: '3', statUnit: 'Monate', statLabel: 'Idee → Launch',
      },
      {
        href: '/references#insurance',
        eyebrow: 'Für Headsquare · Versicherungskonzern, München',
        title: 'Testmanagement im laufenden Betrieb',
        text: 'Qualitätssicherung in einem regulierten Projektumfeld – im Einsatz seit Mai 2026, Ausbau auf drei QA-Experten ab Q4/2026.',
        stat: '1', statUnit: 'QA-Experte', statLabel: 'im Einsatz seit Mai 2026',
      },
    ],
  },
  hr: {
    eyebrow: 'Reference',
    h2: 'Dokazano, ne obećano',
    more: 'Pročitajte case study →',
    cases: [
      {
        href: '/references#plima',
        eyebrow: 'Vlastiti proizvod · HR SaaS',
        title: 'PLIMA: od ideje do lansiranja',
        text: 'HR softver za mala i srednja poduzeća – osmišljen, razvijen i pušten u produkciju. Dva klijenta svakodnevno rade s njim.',
        stat: '3', statUnit: 'mjeseca', statLabel: 'ideja → lansiranje',
      },
      {
        href: '/references#insurance',
        eyebrow: 'Za Headsquare · osiguravajući koncern, München',
        title: 'Test management u produkciji',
        text: 'Osiguranje kvalitete u reguliranom projektnom okruženju – u tijeku od svibnja 2026., proširenje na tri QA stručnjaka od Q4/2026.',
        stat: '1', statUnit: 'QA stručnjak', statLabel: 'u tijeku od svibnja 2026.',
      },
    ],
  },
};
const t = copy[lang];
---

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>{t.h2}</h2>
    </div>

    <div class="cases">
      {
        t.cases.map((c: any) => (
          <a href={l(lang, c.href.split('#')[0]) + '#' + c.href.split('#')[1]} class="case reveal">
            <div class="case-surface card">
              <div class="case-stat">
                <span class="stat-number" data-countup={c.stat}>{c.stat}</span>
                <span class="case-stat-unit">{c.statUnit}</span>
                <span class="case-stat-label">{c.statLabel}</span>
              </div>
              <div class="case-body">
                <span class="case-eyebrow">{c.eyebrow}</span>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
                <span class="case-more" aria-hidden="true">{t.more}</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .case {
    /* Hover-Zustand lebt hier (unbeweglicher Hit-Bereich), damit translateY()
       auf .case-surface die Hover-Fläche nicht verschiebt und am Kartenrand
       zittert. Nur .case-surface hebt sich sichtbar. */
    display: block;
    text-decoration: none;
  }
  .case-surface {
    /* .case (Grid-Item) wird per Grid-Default (align-items: stretch) auf
       Zeilenhöhe gebracht – .case-surface muss das explizit übernehmen,
       sonst bleibt die sichtbare Karte (Border/Background) kürzer als die
       Nachbarkarte, sobald deren Text mehr Zeilen braucht. */
    height: 100%;
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1.75rem;
    padding: 2.25rem;
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .case:hover .case-surface {
    border-color: color-mix(in srgb, var(--mirano-orange) 40%, var(--mirano-border));
    transform: translateY(-3px);
    /* Enter schnell (180ms), Exit ruhig über die Basis-Transition (320ms) */
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .case:active .case-surface {
    transform: translateY(-1px);
  }
  .case:hover .case-more {
    transform: translateX(3px);
  }
  .case-stat {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--mirano-border);
    padding-right: 1.5rem;
  }
  .case .stat-number {
    font-size: 3.25rem;
    line-height: 1;
  }
  .case-stat-unit {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--mirano-ink);
    margin-top: 0.35rem;
  }
  .case-stat-label {
    font-size: 0.75rem;
    color: var(--mirano-muted);
    margin-top: 0.35rem;
    line-height: 1.4;
  }
  .case-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .case-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .case h3 {
    font-size: 1.25rem;
  }
  .case p {
    font-size: 0.9375rem;
    color: var(--mirano-slate);
  }
  .case-more {
    margin-top: auto;
    font-weight: 600;
    font-size: var(--text-small);
    color: var(--mirano-orange-deep);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  @media (max-width: 900px) {
    .cases {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .case-surface {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.75rem;
    }
    .case-stat {
      border-right: none;
      border-bottom: 1px solid var(--mirano-border);
      padding-right: 0;
      padding-bottom: 1.25rem;
    }
  }
</style>

<script>
  import '../scripts/countup';
</script>
