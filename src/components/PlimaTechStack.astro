---
// Kompakte Tech-Stack-Chip-Zeile speziell für PLIMA (nicht das allgemeine
// Technologie-Band – siehe TechBand.astro). Nur bestätigte Technologien.
// variant="plima" (Default, /products): Hover nutzt --plima-primary/--plima-highlight,
//   die von ProductsView bereitgestellt werden – bewusste Marken-Ausnahme, nur dort.
// variant="brand" (/references, PLIMA-Case): Hover nutzt die Original-Markenfarbe je
//   Icon aus simple-icons, gleiche --brand-Technik wie im allgemeinen TechBand.astro.
import * as icons from 'simple-icons';
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
  variant?: 'plima' | 'brand';
}
const { lang, variant = 'plima' } = Astro.props;

const items = [
  { label: 'Java', icon: 'siOpenjdk' },
  { label: 'Spring Boot', icon: 'siSpringboot' },
  { label: 'Vaadin', icon: 'siVaadin' },
  { label: 'PostgreSQL', icon: 'siPostgresql' },
];

const iconSvg = (name: string): string | null => {
  const icon = (icons as Record<string, { svg: string } | undefined>)[name];
  return icon?.svg ?? null;
};

const iconHex = (name: string): string | null => {
  const icon = (icons as Record<string, { hex: string } | undefined>)[name];
  return icon?.hex ?? null;
};

const labels: Record<Lang, string> = {
  en: 'Tech Stack',
  de: 'Tech-Stack',
  hr: 'Tehnologije',
};
---

<div class:list={['plima-tech', variant === 'brand' && 'plima-tech--brand']}>
  <span class="plima-tech-label">{labels[lang]}</span>
  <ul class="plima-tech-list">
    {
      items.map((tech) => {
        const svg = iconSvg(tech.icon);
        const brandHex = variant === 'brand' ? iconHex(tech.icon) : null;
        const style = brandHex ? `--brand: #${brandHex}` : undefined;
        return (
          <li class="plima-tech-chip" style={style}>
            {svg && <span class="plima-tech-icon" set:html={svg} />}
            {tech.label}
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .plima-tech {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .plima-tech-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .plima-tech-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .plima-tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--mirano-slate);
    background: var(--mirano-white);
    border: 1px solid var(--mirano-border);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .plima-tech-chip:hover {
    border-color: color-mix(in srgb, var(--plima-primary) 45%, var(--mirano-border));
  }
  .plima-tech-icon :global(svg) {
    width: 15px;
    height: 15px;
    fill: var(--mirano-muted);
    transition: fill var(--dur-fast) var(--ease-out);
  }
  .plima-tech-chip:hover .plima-tech-icon :global(svg) {
    fill: var(--plima-highlight);
  }

  /* variant="brand": Original-Markenfarbe je Icon statt PLIMA-Lila (siehe TechBand.astro) */
  .plima-tech--brand .plima-tech-chip:hover {
    border-color: color-mix(in srgb, var(--brand, var(--mirano-orange)) 45%, var(--mirano-border));
  }
  .plima-tech--brand .plima-tech-chip:hover .plima-tech-icon :global(svg) {
    fill: var(--brand, var(--mirano-orange));
  }
</style>
