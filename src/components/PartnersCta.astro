---
import { getLang, l, type Lang } from '../i18n';
import fs from 'node:fs';
import path from 'node:path';
import { SHOW_IFTECH } from '../content/site';
const lang = getLang(Astro.currentLocale);

const partners = [
  { name: 'Headsquare', slug: 'headsquare', url: 'https://headsquare.group' },
  { name: 'Serapion', slug: 'serapion', url: 'https://serapion.net' },
  { name: 'Visoka Razina', slug: 'visoka-razina', url: 'https://visokarazina.hr' },
  { name: 'Respect-ing', slug: 'respect-ing', url: 'https://respect-ing.hr' },
  { name: 'Mira Solis', slug: 'mira-solis', url: 'https://mirasolis.hr' },
  ...(SHOW_IFTECH ? [{ name: 'If-Tech', slug: 'if-tech', url: 'https://www.if-tech.de/' }] : []),
].map((p) => {
  const dir = path.join(process.cwd(), 'public/logo/partners');
  const svgPath = path.join(dir, `${p.slug}.svg`);
  const pngPath = path.join(dir, `${p.slug}.png`);
  let logo: string | null = null;
  if (fs.existsSync(svgPath)) logo = `/logo/partners/${p.slug}.svg`;
  else if (fs.existsSync(pngPath)) logo = `/logo/partners/${p.slug}.png`;
  return { ...p, logo };
});

const copy: Record<Lang, any> = {
  en: {
    partnerAltSuffix: 'Mirano Solutions partner',
    partnersLabel: 'Partner network',
    eyebrow: 'Next step',
    h2: 'Tell us about your project',
    text: '30 minutes, directly with the founder: requirements, matching profiles, a realistic timeline. No obligation – and very concrete.',
    ctaPrimary: 'Talk to the founder',
    ctaSecondary: 'Request team capacity',
    trust: 'EU CONTRACTS · GDPR-NATIVE · REPLY WITHIN 24H',
  },
  de: {
    partnerAltSuffix: 'Partner von Mirano Solutions',
    partnersLabel: 'Partnernetzwerk',
    eyebrow: 'Nächster Schritt',
    h2: 'Erzählen Sie uns von Ihrem Projekt',
    text: '30 Minuten, direkt mit dem Gründer: Anforderungen, passende Profile, realistischer Zeitplan. Unverbindlich und konkret.',
    ctaPrimary: 'Mit dem Gründer sprechen',
    ctaSecondary: 'Team-Kapazität anfragen',
    trust: 'EU-VERTRÄGE · DSGVO-NATIV · ANTWORT INNERHALB VON 24H',
  },
  hr: {
    partnerAltSuffix: 'partner Mirano Solutionsa',
    partnersLabel: 'Partnerska mreža',
    eyebrow: 'Sljedeći korak',
    h2: 'Recite nam nešto o svom projektu',
    text: '30 minuta, izravno s osnivačem: zahtjevi, odgovarajući profili, realan vremenski plan. Bez obveze – i vrlo konkretno.',
    ctaPrimary: 'Razgovarajte s osnivačem',
    ctaSecondary: 'Zatražite kapacitet tima',
    trust: 'EU UGOVORI · GDPR-USKLAĐENO · ODGOVOR UNUTAR 24H',
  },
};
const t = copy[lang];
---

<section class="section partners-cta">
  <div class="container">
    <div class="partners reveal">
      <span class="partners-label">{t.partnersLabel}</span>
      <ul>
        {partners.map((p) => {
          const content = p.logo ? (
            <img
              src={p.logo}
              alt={`${p.name} – ${t.partnerAltSuffix}`}
              class:list={['partner-logo', p.slug === 'headsquare' && 'partner-logo--compact']}
            />
          ) : (
            p.name
          );
          return <li>{p.url ? <a href={p.url} target="_blank" rel="noopener">{content}</a> : content}</li>;
        })}
      </ul>
    </div>

    <div class="cta card reveal">
      <div class="cta-accent" aria-hidden="true"></div>
      <div class="cta-copy">
        <span class="eyebrow">{t.eyebrow}</span>
        <h2>{t.h2}</h2>
        <p>{t.text}</p>
      </div>
      <div class="cta-actions">
        <a href={l(lang, '/contact')} class="btn-primary">{t.ctaPrimary}</a>
        <a href={l(lang, '/contact')} class="btn-secondary">{t.ctaSecondary}</a>
        <p class="cta-trust">{t.trust}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .partners {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-bottom: 4rem;
  }
  .partners-label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--mirano-muted);
  }
  .partners ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .partners li {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--mirano-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  /* Logos staffeln einzeln beim Reveal (40ms/Logo); Startzustand nur unter html.js.
     transition-delay als Liste, damit der Farb-Hover (1. Property) nie verzögert wird. */
  :global(.js) .partners.reveal .partners-label,
  :global(.js) .partners.reveal li {
    opacity: 0;
    transform: translateY(8px);
    transition:
      color var(--dur-fast) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  :global(.js) .partners.reveal.is-visible .partners-label,
  :global(.js) .partners.reveal.is-visible li {
    opacity: 1;
    transform: none;
  }
  :global(.js) .partners.reveal.is-visible li:nth-child(1) { transition-delay: 0ms, 40ms, 40ms; }
  :global(.js) .partners.reveal.is-visible li:nth-child(2) { transition-delay: 0ms, 80ms, 80ms; }
  :global(.js) .partners.reveal.is-visible li:nth-child(3) { transition-delay: 0ms, 120ms, 120ms; }
  :global(.js) .partners.reveal.is-visible li:nth-child(4) { transition-delay: 0ms, 160ms, 160ms; }
  :global(.js) .partners.reveal.is-visible li:nth-child(5) { transition-delay: 0ms, 200ms, 200ms; }
  :global(.js) .partners.reveal.is-visible li:nth-child(6) { transition-delay: 0ms, 240ms, 240ms; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .partners.reveal .partners-label,
    :global(.js) .partners.reveal li {
      opacity: 1;
      transform: none;
    }
  }
  .partners li:hover {
    color: var(--mirano-slate);
  }
  .partners li a {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }
  .partner-logo {
    display: block;
    height: 32px;
    width: auto;
    filter: grayscale(100%);
    opacity: 0.55;
    transition: filter var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  /* Headsquare-Wortmarke ist deutlich fetter/blockiger als die anderen fünf Logos
     und rendert dazu am breitesten (227px vs. 63–159px bei identischer 32px-Höhe) –
     wirkt dadurch optisch schwerer, obwohl die Höhe pixelgenau gleich ist. Bewusste
     Gewichts-Korrektur nur für diesen einen Eintrag, keine generelle 32px-Änderung. */
  .partner-logo.partner-logo--compact {
    height: 27px;
  }
  .partners li a:hover .partner-logo,
  .partners li a:focus-visible .partner-logo {
    filter: grayscale(0%);
    opacity: 1;
  }

  .cta {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
    padding: 3rem;
    background: var(--mirano-limestone);
    overflow: hidden;
  }
  .cta-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--mirano-gradient);
    /* Signature-Linie zeichnet sich beim Reveal */
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out) 150ms;
  }
  .cta.is-visible .cta-accent {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-accent {
      transform: none;
    }
  }
  .cta .eyebrow {
    display: block;
    margin-bottom: 0.9rem;
  }
  .cta h2 {
    margin-bottom: 0.9rem;
  }
  .cta p {
    color: var(--mirano-slate);
    max-width: 30rem;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .cta-actions .btn-primary,
  .cta-actions .btn-secondary {
    width: 100%;
    justify-content: center;
  }
  .cta-trust {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    color: var(--mirano-muted);
  }

  @media (max-width: 900px) {
    .cta {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem;
    }
  }
</style>
